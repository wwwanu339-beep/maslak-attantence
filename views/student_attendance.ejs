<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Student Portal - <%= student.full_name %></title>
  <style>
    :root {
      --bg-page: #f1f5f9;
      --surface: #ffffff;
      --border: #e2e8f0;
      --text-dark: #0f172a;
      --text-muted: #64748b;
      --primary: #2563eb;
      --primary-soft: #eff6ff;
    }

    * { box-sizing: border-box; font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
    body { margin: 0; background: var(--bg-page); color: var(--text-dark); padding: 16px; }
    .container { max-width: 780px; margin: 0 auto; }

    /* Top Nav Header */
    .portal-topbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 14px;
      padding: 0 4px;
    }
    .portal-brand {
      font-size: 15px;
      font-weight: 800;
      color: var(--text-dark);
      letter-spacing: -0.2px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .brand-dot {
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: var(--primary);
      display: inline-block;
    }
    .btn-logout {
      background: var(--surface);
      color: #dc2626;
      border: 1px solid #fecaca;
      text-decoration: none;
      padding: 6px 13px;
      border-radius: 8px;
      font-size: 12.5px;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      transition: 0.15s;
    }
    .btn-logout:hover { background: #fef2f2; border-color: #fca5a5; }

    /* Modern Profile Hero Card */
    .profile-card {
      background: var(--surface);
      border-radius: 16px;
      border: 1px solid var(--border);
      box-shadow: 0 4px 16px rgba(15, 23, 42, 0.04);
      overflow: hidden;
      margin-bottom: 16px;
    }
    .profile-banner {
      height: 54px;
      background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%);
    }
    .profile-body {
      padding: 0 20px 18px;
    }
    .profile-main {
      display: flex;
      align-items: flex-end;
      gap: 16px;
      margin-top: -32px;
      flex-wrap: wrap;
    }
    .student-photo {
      width: 82px;
      height: 82px;
      border-radius: 14px;
      object-fit: cover;
      border: 3px solid #ffffff;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
      background: #e2e8f0;
      flex-shrink: 0;
    }
    .photo-empty {
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text-muted);
      font-size: 11px;
      font-weight: 700;
    }
    .student-heading {
      padding-top: 36px;
      flex: 1;
      min-width: 200px;
    }
    .student-heading h2 {
      margin: 0 0 4px;
      font-size: 19px;
      font-weight: 800;
      color: var(--text-dark);
    }
    .batch-tag {
      display: inline-block;
      background: var(--primary-soft);
      color: var(--primary);
      border: 1px solid #bfdbfe;
      padding: 2px 10px;
      border-radius: 99px;
      font-size: 11.5px;
      font-weight: 700;
    }

    /* Info Pills Grid */
    .info-pills {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;
      margin-top: 16px;
      padding-top: 14px;
      border-top: 1px solid #f1f5f9;
    }
    .info-item {
      background: #f8fafc;
      padding: 8px 11px;
      border-radius: 10px;
      border: 1px solid #f1f5f9;
    }
    .info-item span {
      display: block;
      font-size: 11px;
      color: var(--text-muted);
      font-weight: 600;
      margin-bottom: 2px;
    }
    .info-item strong {
      font-size: 13px;
      color: var(--text-dark);
      font-weight: 700;
    }

    /* Quick Action Bar */
    .action-bar {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin-top: 14px;
      padding-top: 14px;
      border-top: 1px solid #f1f5f9;
    }
    .btn-action {
      background: #ffffff;
      color: #1e293b;
      border: 1px solid #cbd5e1;
      text-decoration: none;
      padding: 8px 14px;
      border-radius: 9px;
      font-size: 12.5px;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: 0.15s;
    }
    .btn-action:hover {
      background: #f8fafc;
      border-color: #94a3b8;
      transform: translateY(-1px);
    }
    .btn-action.primary-pill {
      background: var(--primary-soft);
      color: var(--primary);
      border-color: #bfdbfe;
    }
    .btn-action.primary-pill:hover {
      background: #dbeafe;
    }

    /* Stats Cards */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
      margin-bottom: 16px;
    }
    .stat-box {
      background: var(--surface);
      padding: 14px 12px;
      border-radius: 14px;
      border: 1px solid var(--border);
      box-shadow: 0 2px 8px rgba(15, 23, 42, 0.03);
      position: relative;
      overflow: hidden;
    }
    .stat-box::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 3.5px;
    }
    .stat-p::before { background: #16a34a; }
    .stat-a::before { background: #dc2626; }
    .stat-l::before { background: #eab308; }
    .stat-pct::before { background: #2563eb; }

    .stat-box h4 { margin: 2px 0 3px; font-size: 22px; font-weight: 800; }
    .stat-box span { font-size: 11.5px; color: var(--text-muted); font-weight: 700; text-transform: uppercase; letter-spacing: 0.3px; }
    .p-color { color: #16a34a; }
    .a-color { color: #dc2626; }
    .l-color { color: #ca8a04; }
    .pct-color { color: #2563eb; }

    /* Filter Card */
    .filter-card {
      background: var(--surface);
      padding: 12px 16px;
      border-radius: 12px;
      border: 1px solid var(--border);
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 14px;
    }
    .filter-title {
      font-size: 14px;
      font-weight: 800;
      color: var(--text-dark);
    }
    .filter-controls {
      display: flex;
      gap: 8px;
      align-items: center;
    }
    select {
      padding: 7px 11px;
      border-radius: 8px;
      border: 1px solid #cbd5e1;
      font-size: 13px;
      font-weight: 600;
      color: var(--text-dark);
      background: #f8fafc;
      outline: none;
    }
    select:focus { border-color: var(--primary); background: #fff; }
    .btn-show {
      background: var(--primary);
      color: #fff;
      border: none;
      padding: 8px 16px;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
    }
    .btn-show:hover { background: #1d4ed8; }

    /* Attendance Table */
    .table-card {
      background: var(--surface);
      border-radius: 14px;
      border: 1px solid var(--border);
      box-shadow: 0 2px 10px rgba(15, 23, 42, 0.03);
      overflow-x: auto;
    }
    table { width: 100%; border-collapse: collapse; font-size: 13.5px; text-align: left; }
    th {
      background: #f8fafc;
      color: var(--text-muted);
      font-size: 11.5px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.4px;
      padding: 12px 16px;
      border-bottom: 1px solid var(--border);
    }
    td { padding: 12px 16px; border-bottom: 1px solid #f1f5f9; color: #334155; }
    tr:last-child td { border-bottom: none; }
    tr:hover td { background: #f8fafc; }

    .badge { padding: 4px 10px; border-radius: 99px; font-size: 11px; font-weight: 800; display: inline-block; letter-spacing: 0.3px; }
    .badge.present { background: #dcfce7; color: #15803d; }
    .badge.absent { background: #fee2e2; color: #b91c1c; }
    .badge.leave { background: #fef9c3; color: #854d0e; }

    @media (max-width: 640px) {
      .info-pills { grid-template-columns: repeat(2, 1fr); }
      .stats-grid { grid-template-columns: repeat(2, 1fr); }
    }
  </style>
</head>
<body>
  <div class="container">
    <!-- Top Header -->
    <div class="portal-topbar">
      <div class="portal-brand">
        <span class="brand-dot"></span>
        <span>Student Portal</span>
      </div>
      <a href="/student-logout" class="btn-logout">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        Logout
      </a>
    </div>

    <!-- Profile Hero Card -->
    <div class="profile-card">
      <div class="profile-banner"></div>
      <div class="profile-body">
        <div class="profile-main">
          <% if (student.photo_url) { %>
            <img src="<%= student.photo_url %>" alt="Photo" class="student-photo">
          <% } else { %>
            <div class="student-photo photo-empty">No Photo</div>
          <% } %>

          <div class="student-heading">
            <h2><%= student.full_name %></h2>
            <span class="batch-tag"><%= student.main_batch_name %></span>
          </div>
        </div>

        <div class="info-pills">
          <div class="info-item">
            <span>Admission No</span>
            <strong><%= student.admission_no %></strong>
          </div>
          <div class="info-item">
            <span>Date of Birth</span>
            <strong><%= student.dob || '-' %></strong>
          </div>
          <div class="info-item">
            <span>Phone Number</span>
            <strong><%= student.phone || '-' %></strong>
          </div>
          <div class="info-item">
            <span>Place</span>
            <strong><%= student.place || '-' %></strong>
          </div>
        </div>

        <div class="action-bar">
          <% if (typeof perms === 'undefined' || perms.showIdCard) { %>
            <a href="/my-id-card" target="_blank" class="btn-action primary-pill">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="2"/><path d="M15 8h2"/><path d="M15 12h2"/><path d="M7 16h10"/></svg>
              ID Card
            </a>
          <% } %>

          <% if (typeof perms === 'undefined' || perms.showForm) { %>
            <a href="/my-admission-form" target="_blank" class="btn-action">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
              <%= (typeof perms !== 'undefined' && perms.allowEdit) ? 'Admission Application (Edit / Print)' : 'Admission Application' %>
            </a>
          <% } %>

          <% if (student.photo_url) { %>
            <a href="<%= student.photo_url %>" download="<%= student.admission_no %>_photo.jpg" target="_blank" class="btn-action">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              Download Photo
            </a>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Attendance Summary Stats -->
    <div class="stats-grid">
      <div class="stat-box stat-p">
        <h4 class="p-color"><%= stats.present %></h4>
        <span>Present (P)</span>
      </div>
      <div class="stat-box stat-a">
        <h4 class="a-color"><%= stats.absent %></h4>
        <span>Absent (A)</span>
      </div>
      <div class="stat-box stat-l">
        <h4 class="l-color"><%= stats.leave %></h4>
        <span>Leave (L)</span>
      </div>
      <div class="stat-box stat-pct">
        <h4 class="pct-color"><%= stats.percentage %>%</h4>
        <span>Attendance</span>
      </div>
    </div>

    <!-- Month/Year Filter -->
    <form class="filter-card" method="GET" action="/my-attendance">
      <span class="filter-title">Attendance History</span>
      <div class="filter-controls">
        <select name="month">
          <% const months = ['January','February','March','April','May','June','July','August','September','October','November','December']; %>
          <% months.forEach((m, idx) => { %>
            <option value="<%= idx + 1 %>" <%= selectedMonth === (idx + 1) ? 'selected' : '' %>><%= m %></option>
          <% }) %>
        </select>
        <select name="year">
          <% [2026, 2027, 2028].forEach(y => { %>
            <option value="<%= y %>" <%= selectedYear === y ? 'selected' : '' %>><%= y %></option>
          <% }) %>
        </select>
        <button type="submit" class="btn-show">Show</button>
      </div>
    </form>

    <!-- Attendance Records Table -->
    <div class="table-card">
      <table>
        <thead>
          <tr>
            <th>Date</th>
            <th>Subject</th>
            <th>Teacher</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% if (records.length === 0) { %>
            <tr>
              <td colspan="4" style="text-align: center; color: #64748b; padding: 28px;">No attendance records found for this month.</td>
            </tr>
          <% } else { %>
            <% records.forEach(r => { %>
              <tr>
                <td><strong><%= r.date %></strong></td>
                <td><%= r.subject %></td>
                <td><%= r.teacher %></td>
                <td><span class="badge <%= r.status %>"><%= r.status.toUpperCase() %></span></td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</body>
</html>