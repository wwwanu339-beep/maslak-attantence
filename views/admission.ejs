<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Student Admissions</title>
  <link rel="stylesheet" href="/student.css">
  <style>
    /* Standard Button System */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 9px 16px;
      font-size: 13.5px;
      font-weight: 600;
      font-family: inherit;
      line-height: 1.2;
      border-radius: 7px;
      border: 1px solid transparent;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.18s ease;
      white-space: nowrap;
    }
    .btn:active { transform: scale(0.98); }

    .btn-sm {
      padding: 6px 11px;
      font-size: 12px;
      border-radius: 6px;
    }

    .btn-primary { background-color: #2563eb; color: #ffffff; }
    .btn-primary:hover { background-color: #1d4ed8; }

    .btn-secondary { background-color: #475569; color: #ffffff; }
    .btn-secondary:hover { background-color: #334155; }

    .btn-draft { background-color: #f1f5f9; color: #334155; border-color: #cbd5e1; }
    .btn-draft:hover { background-color: #e2e8f0; color: #0f172a; }

    .btn-success { background-color: #16a34a; color: #ffffff; }
    .btn-success:hover { background-color: #15803d; }

    .btn-warning { background-color: #d97706; color: #ffffff; }
    .btn-warning:hover { background-color: #b45309; }

    .btn-danger { background-color: #dc2626; color: #ffffff; }
    .btn-danger:hover { background-color: #b91c1c; }

    .btn-edit-std { background-color: #0284c7; color: #ffffff; }
    .btn-edit-std:hover { background-color: #0369a1; }

    .action-btns {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      flex-wrap: nowrap;
    }

    /* Status Badges & Form Fields */
    .status-badge { padding: 4px 10px; border-radius: 6px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.4px; }
    .status-active { background: #dcfce7; color: #15803d; }
    .status-pending { background: #fef08a; color: #854d0e; }
    .status-draft { background: #e2e8f0; color: #475569; }

    .readonly-adm { background-color: #f1f5f9 !important; font-weight: 700; color: #0f172a; cursor: not-allowed; }
    .top-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 10px; }

    .field-box label { font-size: 12px; font-weight: 600; color: #475569; display: block; margin-bottom: 5px; }
    .field-box input, .field-box textarea {
      width: 100%;
      padding: 9px 12px;
      border: 1px solid #cbd5e1;
      border-radius: 7px;
      font-size: 14px;
      font-family: inherit;
      box-sizing: border-box;
    }
    .field-box input:focus, .field-box textarea:focus {
      outline: none;
      border-color: #2563eb;
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
    }

    .full-span { grid-column: 1 / -1; }
    .doc-link { color: #2563eb; text-decoration: none; font-size: 12px; font-weight: 600; }
    .doc-link:hover { text-decoration: underline; }
    .student-thumb { width: 38px; height: 38px; border-radius: 50%; object-fit: cover; border: 1px solid #cbd5e1; }

    /* Modal Styles */
    .modal { display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.6); justify-content: center; align-items: center; z-index: 1000; padding: 15px; overflow-y: auto; }
    .modal-content { background: #fff; padding: 24px; border-radius: 12px; width: 100%; max-width: 680px; max-height: 90vh; overflow-y: auto; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.15); animation: modalFade 0.18s ease-out; }
    @keyframes modalFade {
      from { opacity: 0; transform: translateY(-10px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .modal-header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #e2e8f0; padding-bottom: 12px; margin-bottom: 16px; }
    .modal-header h3 { margin: 0; font-size: 18px; color: #0f172a; }
    .modal-close { background: none; border: none; font-size: 24px; color: #64748b; cursor: pointer; line-height: 1; }
    .modal-close:hover { color: #0f172a; }
    .modal-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 20px; padding-top: 14px; border-top: 1px solid #e2e8f0; flex-wrap: wrap; }
  </style>
</head>
<body>

  <div class="container">
    <div class="top-bar">
      <h1 style="margin: 0;">Student Admission Portal</h1>
      <div style="display: flex; gap: 10px; flex-wrap: wrap;">
        <button type="button" class="btn btn-success" onclick="openNewAdmModal()">+ New Admission</button>
        <a href="/students" class="btn btn-primary">Active Student List →</a>
        <a href="/dashboard" class="btn btn-secondary">Dashboard</a>
      </div>
    </div>

    <!-- 1. All Admissions Table -->
    <div class="card">
      <h3>All Admissions (<%= allStudents.length %>) — Only active students appear in Student List & Attendance</h3>
      <div class="table-responsive">
        <table>
          <thead>
            <tr>
              <th>Photo</th>
              <th>Adm No</th>
              <th>Student & Father</th>
              <th>DOB</th>
              <th>Aadhaar / Docs</th>
              <th>Batch</th>
              <th>Status</th>
              <th style="text-align: center;">Action</th>
            </tr>
          </thead>
          <tbody>
            <% if (allStudents.length === 0) { %>
              <tr>
                <td colspan="8" style="text-align: center; color: #64748b; padding: 24px;">
                  No admission records found. Click <strong>"+ New Admission"</strong> to add a student.
                </td>
              </tr>
            <% } %>

            <% allStudents.forEach(s => { %>
              <tr>
                <td>
                  <% if (s.photo_file) { %>
                    <a href="<%= s.photo_file %>" target="_blank">
                      <img src="<%= s.photo_file %>" alt="Photo" class="student-thumb">
                    </a>
                  <% } else { %>
                    <span style="font-size: 11px; color: #94a3b8;">No Photo</span>
                  <% } %>
                </td>
                <td><strong><%= s.admission_no || '-' %></strong></td>
                <td>
                  <strong><%= s.full_name %></strong><br>
                  <small style="color: #64748b;">Father: <%= s.father_name || '-' %></small>
                </td>
                <td><%= s.dob || '-' %></td>
                <td>
                  <div style="font-size: 12px;"><%= s.aadhaar_no || '-' %></div>
                  <% if (s.aadhaar_file) { %>
                    <a href="<%= s.aadhaar_file %>" target="_blank" class="doc-link">View Document ↗</a>
                  <% } %>
                </td>
                <td><span class="badge"><%= s.batch_name || 'No Batch' %></span></td>
                <td>
                  <span class="status-badge status-<%= s.status %>">
                    <%= s.status %>
                  </span>
                </td>
                <td>
                  <div class="action-btns">
                    <button type="button" class="btn btn-sm btn-edit-std"
                      data-adm="<%= s.admission_no || '' %>"
                      data-roll="<%= s.roll_no || '' %>"
                      data-name="<%= s.full_name || '' %>"
                      data-dob="<%= s.dob || '' %>"
                      data-father="<%= s.father_name || '' %>"
                      data-phone="<%= s.phone || '' %>"
                      data-aadhaar="<%= s.aadhaar_no || '' %>"
                      data-address="<%= s.address || '' %>"
                      data-batch="<%= s.batch_id || '' %>"
                      data-status="<%= s.status || 'pending' %>"
                      data-photo="<%= s.photo_file || '' %>"
                      data-doc="<%= s.aadhaar_file || '' %>"
                      onclick="openEditAdmModal(this)">
                      Edit
                    </button>

                    <% if (s.status !== 'active') { %>
                      <button type="button" class="btn btn-sm btn-success"
                        onclick="toggleStudentStatus('<%= s.admission_no %>', 'active')">
                        Make Active
                      </button>
                    <% } else { %>
                      <button type="button" class="btn btn-sm btn-warning"
                        onclick="toggleStudentStatus('<%= s.admission_no %>', 'pending')">
                        Deactivate
                      </button>
                    <% } %>

                    <button type="button" class="btn btn-sm btn-danger"
                      onclick="deleteAdmission('<%= s.admission_no %>')">
                      Delete
                    </button>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- 2. New Admission Popup Modal -->
  <div id="newAdmModal" class="modal" onclick="if(event.target === this) closeNewAdmModal()">
    <div class="modal-content">
      <div class="modal-header">
        <h3>New Student Admission</h3>
        <button type="button" class="modal-close" onclick="closeNewAdmModal()">×</button>
      </div>

      <form id="admissionForm" enctype="multipart/form-data">
        <div class="form-grid">
          <div class="field-box">
            <label>Auto Admission No:</label>
            <input type="text" id="admNo" value="<%= nextAdmissionNo %>" class="readonly-adm" readonly>
          </div>

          <div class="field-box">
            <label>Roll No (Optional):</label>
            <input type="number" id="stRoll" name="roll_no" placeholder="Roll No (e.g., 1)" min="1">
          </div>

          <div class="field-box">
            <label>Full Name: <span style="color:#dc2626;">*</span></label>
            <input type="text" id="stName" name="full_name" placeholder="Student Full Name" required>
          </div>

          <div class="field-box">
            <label>Date of Birth: <span style="color:#dc2626;">*</span></label>
            <input type="date" id="stDob" name="dob" required>
          </div>

          <div class="field-box">
            <label>Father's Name:</label>
            <input type="text" id="stFather" name="father_name" placeholder="Father's Name">
          </div>

          <div class="field-box">
            <label>Phone Number:</label>
            <input type="text" id="stPhone" name="phone" placeholder="Phone Number">
          </div>

          <div class="field-box">
            <label>Aadhaar Number:</label>
            <input type="text" id="stAadhaar" name="aadhaar_no" placeholder="12-digit ID Number" maxlength="14">
          </div>

          <div class="field-box">
            <label>Login Password:</label>
            <input type="password" id="stPass" name="password" placeholder="Defaults to Admission No if empty">
          </div>

          <div class="field-box full-span">
            <label>Full Address:</label>
            <textarea id="stAddress" name="address" rows="2" placeholder="House Name, Place, Post, District, PIN"></textarea>
          </div>

          <div class="field-box">
            <label>Student Photo Upload:</label>
            <input type="file" id="stPhoto" name="photo" accept="image/*">
          </div>

          <div class="field-box">
            <label>Aadhaar Card Upload (Image/PDF):</label>
            <input type="file" id="stAadhaarFile" name="aadhaar_doc" accept="image/*,.pdf">
          </div>

          <div class="batch-selection-wrapper full-span">
            <span class="batch-selection-title">Select Batches (Optional for Draft):</span>
            <div class="batch-checkbox-group">
              <% batches.forEach(b => { %>
                <label class="batch-chip">
                  <input type="checkbox" name="admBatches" value="<%= b.id %>">
                  <span><%= b.name %></span>
                </label>
              <% }) %>
            </div>
          </div>
        </div>

        <div class="modal-actions">
          <button type="button" class="btn btn-secondary" onclick="closeNewAdmModal()">Cancel</button>
          <button type="button" class="btn btn-draft" onclick="submitAdmission('draft')">Save Draft</button>
          <button type="button" class="btn btn-primary" onclick="submitAdmission('pending')">Submit Admission</button>
        </div>
      </form>
    </div>
  </div>

  <!-- 3. Edit Admission Modal -->
  <div id="editAdmModal" class="modal" onclick="if(event.target === this) closeEditAdmModal()">
    <div class="modal-content">
      <div class="modal-header">
        <h3>Edit Admission Details</h3>
        <button type="button" class="modal-close" onclick="closeEditAdmModal()">×</button>
      </div>
      <input type="hidden" id="editAdmStatus">

      <div class="form-grid">
        <div class="field-box">
          <label>Admission No (Read-only):</label>
          <input type="text" id="editAdmNo" class="readonly-adm" readonly>
        </div>

        <div class="field-box">
          <label>Roll No:</label>
          <input type="number" id="editAdmRoll" min="1" placeholder="Roll No">
        </div>

        <div class="field-box">
          <label>Full Name: <span style="color:#dc2626;">*</span></label>
          <input type="text" id="editAdmName" required>
        </div>

        <div class="field-box">
          <label>Date of Birth: <span style="color:#dc2626;">*</span></label>
          <input type="date" id="editAdmDob" required>
        </div>

        <div class="field-box">
          <label>Father's Name:</label>
          <input type="text" id="editAdmFather" placeholder="Father's Name">
        </div>

        <div class="field-box">
          <label>Phone Number:</label>
          <input type="text" id="editAdmPhone" placeholder="Phone Number">
        </div>

        <div class="field-box">
          <label>Aadhaar Number:</label>
          <input type="text" id="editAdmAadhaar" maxlength="14" placeholder="12-digit ID Number">
        </div>

        <div class="field-box">
          <label>New Password (Leave blank to keep current):</label>
          <input type="password" id="editAdmPass" placeholder="Optional">
        </div>

        <div class="field-box full-span">
          <label>Full Address:</label>
          <textarea id="editAdmAddress" rows="2" placeholder="Full Address"></textarea>
        </div>

        <div class="field-box">
          <label>Update Photo (Optional): <span id="currentPhotoLink"></span></label>
          <input type="file" id="editAdmPhoto" accept="image/*">
        </div>

        <div class="field-box">
          <label>Update Aadhaar Doc (Optional): <span id="currentDocLink"></span></label>
          <input type="file" id="editAdmAadhaarFile" accept="image/*,.pdf">
        </div>

        <div class="batch-selection-wrapper full-span">
          <span class="batch-selection-title">Select Batches:</span>
          <div class="batch-checkbox-group">
            <% batches.forEach(b => { %>
              <label class="batch-chip">
                <input type="checkbox" name="editAdmBatches" value="<%= b.id %>">
                <span><%= b.name %></span>
              </label>
            <% }) %>
          </div>
        </div>
      </div>

      <div class="modal-actions">
        <button type="button" class="btn btn-secondary" onclick="closeEditAdmModal()">Cancel</button>
        <button type="button" class="btn btn-draft" onclick="saveAdmissionEdit('draft')">Save as Draft</button>
        <button type="button" class="btn btn-primary" onclick="saveAdmissionEdit('submit')">Update & Submit</button>
      </div>
    </div>
  </div>

  <script>
    function cleanVal(val) {
      if (!val || val === 'undefined' || val === 'null') return '';
      return String(val).trim();
    }

    function openNewAdmModal() {
      document.getElementById('newAdmModal').style.display = 'flex';
      setTimeout(() => document.getElementById('stName').focus(), 100);
    }

    function closeNewAdmModal() {
      document.getElementById('newAdmModal').style.display = 'none';
    }

    async function submitAdmission(saveMode) {
      const full_name = document.getElementById('stName').value.trim();
      const dob = document.getElementById('stDob').value.trim();

      if (!full_name || !dob) {
        return alert('Please enter both Full Name and Date of Birth!');
      }

      const batch_id = Array.from(document.querySelectorAll('input[name="admBatches"]:checked'))
        .map(cb => cb.value)
        .join(',');

      if (saveMode === 'pending' && !batch_id) {
        return alert('Please select at least one batch to submit! (Or click Save Draft)');
      }

      const formData = new FormData();
      formData.append('full_name', full_name);
      formData.append('dob', dob);
      formData.append('roll_no', document.getElementById('stRoll').value.trim());
      formData.append('father_name', document.getElementById('stFather').value.trim());
      formData.append('phone', document.getElementById('stPhone').value.trim());
      formData.append('aadhaar_no', document.getElementById('stAadhaar').value.trim());
      formData.append('address', document.getElementById('stAddress').value.trim());
      formData.append('password', document.getElementById('stPass').value.trim());
      formData.append('batch_id', batch_id);
      formData.append('status', saveMode);

      const photoInput = document.getElementById('stPhoto');
      if (photoInput.files[0]) formData.append('photo', photoInput.files[0]);

      const aadhaarInput = document.getElementById('stAadhaarFile');
      if (aadhaarInput.files[0]) formData.append('aadhaar_doc', aadhaarInput.files[0]);

      try {
        const res = await fetch('/api/admissions', {
          method: 'POST',
          body: formData
        });
        const data = await res.json();
        if (data.success) {
          const msg = saveMode === 'draft'
            ? `Saved as Draft! Admission No: ${data.admission_no}`
            : `Admission submitted! Admission No: ${data.admission_no}\n(Click "Make Active" to move student to the active list)`;
          alert(msg);
          location.reload();
        } else {
          alert('Error: ' + (data.error || 'Failed to save admission!'));
        }
      } catch (err) {
        alert('Server connection failed!');
      }
    }

    function openEditAdmModal(btn) {
      const adm = cleanVal(btn.getAttribute('data-adm'));
      const roll = cleanVal(btn.getAttribute('data-roll'));
      const name = cleanVal(btn.getAttribute('data-name'));
      const rawDob = cleanVal(btn.getAttribute('data-dob'));
      const father = cleanVal(btn.getAttribute('data-father'));
      const phone = cleanVal(btn.getAttribute('data-phone'));
      const aadhaar = cleanVal(btn.getAttribute('data-aadhaar'));
      const address = cleanVal(btn.getAttribute('data-address'));
      const batchStr = cleanVal(btn.getAttribute('data-batch'));
      const status = cleanVal(btn.getAttribute('data-status')) || 'pending';
      const photoUrl = cleanVal(btn.getAttribute('data-photo'));
      const docUrl = cleanVal(btn.getAttribute('data-doc'));

      let formattedDob = rawDob;
      if (rawDob && rawDob.includes('/')) {
        const parts = rawDob.split('/');
        if (parts[2] && parts[2].length === 4) {
          formattedDob = `${parts[2]}-${parts[1].padStart(2, '0')}-${parts[0].padStart(2, '0')}`;
        }
      }

      document.getElementById('editAdmStatus').value = status;
      document.getElementById('editAdmNo').value = adm;
      document.getElementById('editAdmRoll').value = roll;
      document.getElementById('editAdmName').value = name;
      document.getElementById('editAdmDob').value = formattedDob;
      document.getElementById('editAdmFather').value = father;
      document.getElementById('editAdmPhone').value = phone;
      document.getElementById('editAdmAadhaar').value = aadhaar;
      document.getElementById('editAdmAddress').value = address;
      document.getElementById('editAdmPass').value = '';
      document.getElementById('editAdmPhoto').value = '';
      document.getElementById('editAdmAadhaarFile').value = '';

      document.getElementById('currentPhotoLink').innerHTML = photoUrl
        ? `(<a href="${photoUrl}" target="_blank" class="doc-link">Current</a>)`
        : '';
      document.getElementById('currentDocLink').innerHTML = docUrl
        ? `(<a href="${docUrl}" target="_blank" class="doc-link">Current</a>)`
        : '';

      const assignedBatches = batchStr.split(',').map(b => b.trim()).filter(Boolean);
      document.querySelectorAll('input[name="editAdmBatches"]').forEach(cb => {
        cb.checked = assignedBatches.includes(String(cb.value).trim());
      });

      document.getElementById('editAdmModal').style.display = 'flex';
    }

    function closeEditAdmModal() {
      document.getElementById('editAdmModal').style.display = 'none';
    }

    async function saveAdmissionEdit(mode) {
      const admNo = document.getElementById('editAdmNo').value.trim();
      const currentStatus = document.getElementById('editAdmStatus').value;
      const full_name = document.getElementById('editAdmName').value.trim();
      const dob = document.getElementById('editAdmDob').value.trim();

      if (!full_name || !dob) {
        return alert('Full Name and Date of Birth are required!');
      }

      const batch_id = Array.from(document.querySelectorAll('input[name="editAdmBatches"]:checked'))
        .map(cb => cb.value)
        .join(',');

      let newStatus = currentStatus;
      if (mode === 'draft') {
        newStatus = 'draft';
      } else if (currentStatus === 'draft') {
        if (!batch_id) return alert('Please select at least one batch before submitting!');
        newStatus = 'pending';
      }

      const formData = new FormData();
      formData.append('full_name', full_name);
      formData.append('dob', dob);
      formData.append('roll_no', document.getElementById('editAdmRoll').value.trim());
      formData.append('father_name', document.getElementById('editAdmFather').value.trim());
      formData.append('phone', document.getElementById('editAdmPhone').value.trim());
      formData.append('aadhaar_no', document.getElementById('editAdmAadhaar').value.trim());
      formData.append('address', document.getElementById('editAdmAddress').value.trim());
      formData.append('password', document.getElementById('editAdmPass').value.trim());
      formData.append('batch_id', batch_id);
      formData.append('status', newStatus);

      const photoInput = document.getElementById('editAdmPhoto');
      if (photoInput.files[0]) formData.append('photo', photoInput.files[0]);

      const aadhaarInput = document.getElementById('editAdmAadhaarFile');
      if (aadhaarInput.files[0]) formData.append('aadhaar_doc', aadhaarInput.files[0]);

      try {
        const res = await fetch(`/api/admissions/${encodeURIComponent(admNo)}`, {
          method: 'PUT',
          body: formData
        });
        const data = await res.json();
        if (data.success) location.reload();
        else alert('Error: ' + (data.error || 'Failed to update admission!'));
      } catch (err) {
        alert('Server error while updating!');
      }
    }

    async function toggleStudentStatus(admNo, newStatus) {
      try {
        const res = await fetch(`/api/admissions/${encodeURIComponent(admNo)}/status`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status: newStatus })
        });
        const data = await res.json();
        if (data.success) location.reload();
        else alert('Error: ' + (data.error || 'Failed to change status!'));
      } catch (err) {
        alert('Server error!');
      }
    }

    async function deleteAdmission(admNo) {
      if (!confirm('Are you sure you want to permanently delete this admission record?')) return;
      try {
        const res = await fetch(`/api/admissions/${encodeURIComponent(admNo)}`, { method: 'DELETE' });
        const data = await res.json();
        if (data.success) location.reload();
        else alert('Error: ' + (data.error || 'Failed to delete!'));
      } catch (err) {
        alert('Failed to delete admission record!');
      }
    }
  </script>
</body>
</html>
