<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Student Admissions</title>
  <link rel="stylesheet" href="/student.css">
  <link rel="stylesheet" href="/admission.css">
</head>
<body>

  <%
    const safeBranding = (typeof branding !== 'undefined' && branding) ? branding : { headerUrl: '', footerUrl: '' };
  %>

  <div class="container">
    <div class="top-bar">
      <h1 class="top-bar-title">Student Admissions</h1>

      <div class="top-bar-actions-group">
        <a href="/dashboard" class="btn-header-icon" title="Back to Dashboard" aria-label="Back to Dashboard">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 12H5"></path>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
        </a>

        <div class="header-menu-wrapper" id="headerMenuWrapper">
          <button type="button" class="btn-header-icon" id="headerMenuBtn" onclick="toggleHeaderMenu(event)" title="Options" aria-label="Options Menu">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="5" r="1.5"></circle>
              <circle cx="12" cy="12" r="1.5"></circle>
              <circle cx="12" cy="19" r="1.5"></circle>
            </svg>
          </button>

          <div class="header-dropdown-menu" id="headerDropdownMenu">
            <button type="button" class="menu-drop-item item-success" onclick="closeHeaderMenu(); openNewAdmModal();">
              <span>+ New Admission</span>
            </button>
            <a href="/students" class="menu-drop-item item-primary">
              <span>Active Student List →</span>
            </a>
            <button type="button" class="menu-drop-item item-warning" onclick="closeHeaderMenu(); openBrandingModal();">
              <span>Print Header / Footer</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- 1. All Admissions Table -->
    <div class="card">
      <h3>All Admissions (<%= allStudents.length %>)</h3>
      <p class="card-subtitle">Only active students appear in the Active Student List & Attendance.</p>

      <div class="table-responsive">
        <table id="admissionsTable">
          <thead>
            <tr>
              <th>Photo</th>
              <th>Adm No</th>
              <th>Student & Father</th>
              <th>DOB</th>
              <th>Aadhaar / Docs</th>
              <th>Main Batch</th>
              <th>Status</th>
              <th style="text-align: center;">Action</th>
            </tr>
          </thead>
          <tbody>
            <% if (allStudents.length === 0) { %>
              <tr>
                <td colspan="8" class="empty-row">
                  No admission records found. Tap the menu icon (<strong>⋮</strong>) above to add a new admission.
                </td>
              </tr>
            <% } %>

            <% allStudents.forEach((s, index) => { %>
              <tr>
                <td data-label="Photo">
                  <% if (s.photo_file) { %>
                    <a href="<%= s.photo_file %>" target="_blank">
                      <img src="<%= s.photo_file %>" alt="Photo" class="student-thumb">
                    </a>
                  <% } else { %>
                    <span class="no-photo-tag">No<br>Photo</span>
                  <% } %>
                </td>
                <td data-label="Adm No"><strong><%= s.admission_no || '-' %></strong></td>
                <td data-label="Student">
                  <div>
                    <strong><%= s.full_name %></strong>
                    <span class="student-meta-sub">Father: <%= s.father_name || '-' %></span>
                  </div>
                </td>
                <td data-label="DOB"><%= s.dob || '-' %></td>
                <td data-label="Aadhaar / Docs">
                  <div>
                    <div class="aadhaar-text"><%= s.aadhaar_no || '-' %></div>
                    <% if (s.aadhaar_file) { %>
                      <a href="<%= s.aadhaar_file %>" target="_blank" class="doc-link">View Document ↗</a>
                    <% } %>
                  </div>
                </td>
                <td data-label="Main Batch"><span class="badge"><%= s.main_batch_name || s.batch_name || 'No Batch' %></span></td>
                <td data-label="Status">
                  <select class="status-select st-<%= s.status %>"
                          data-current="<%= s.status %>"
                          data-adm="<%= s.admission_no %>"
                          onchange="handleStatusDropdown(this)">
                    <% if (s.status === 'draft') { %>
                      <option value="draft" selected>Draft</option>
                    <% } %>
                    <option value="pending" <%= s.status === 'pending' ? 'selected' : '' %>>Not Active</option>
                    <option value="active" <%= s.status === 'active' ? 'selected' : '' %>>Active</option>
                  </select>
                </td>
                <td data-label="Action">
                  <div class="action-btns">
                    <button type="button" class="btn btn-sm btn-edit-std" data-index="<%= index %>" onclick="openEditAdmByIndex(this.dataset.index)">
                      Edit
                    </button>
                    <button type="button" class="btn btn-sm btn-secondary" data-index="<%= index %>" onclick="printAdmByIndex(this.dataset.index)">
                      Print
                    </button>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- 2. New Admission Popup Modal -->
  <div id="newAdmModal" class="modal" onclick="if(event.target === this) closeNewAdmModal()">
    <div class="modal-content modal-lg">
      <div class="modal-header">
        <h3>New Student Admission</h3>
        <button type="button" class="modal-close" onclick="closeNewAdmModal()">×</button>
      </div>

      <form id="admissionForm" enctype="multipart/form-data">
        <div class="form-grid">
          <div class="field-box">
            <label>Auto Admission No:</label>
            <input type="text" id="admNo" value="<%= nextAdmissionNo %>" class="readonly-adm" readonly>
          </div>

          <div class="field-box">
            <label>Roll No (Optional):</label>
            <input type="number" id="stRoll" name="roll_no" placeholder="Roll No (e.g., 1)" min="1">
          </div>

          <div class="field-box">
            <label>Full Name: <span class="req-star">*</span></label>
            <input type="text" id="stName" name="full_name" placeholder="Student Full Name" required>
          </div>

          <div class="field-box">
            <label>Date of Birth: <span class="req-star">*</span></label>
            <input type="date" id="stDob" name="dob" required>
          </div>

          <div class="field-box">
            <label>Father's Name:</label>
            <input type="text" id="stFather" name="father_name" placeholder="Father's Name">
          </div>

          <div class="field-box">
            <label>Phone Number:</label>
            <input type="text" id="stPhone" name="phone" placeholder="Phone Number">
          </div>

          <div class="field-box">
            <label>Aadhaar Number:</label>
            <input type="text" id="stAadhaar" name="aadhaar_no" placeholder="12-digit ID Number" maxlength="14">
          </div>

          <div class="field-box">
            <label>Login Password:</label>
            <input type="password" id="stPass" name="password" placeholder="Defaults to Admission No if empty">
          </div>

          <div class="field-box full-span">
            <label>Full Address:</label>
            <textarea id="stAddress" name="address" rows="2" placeholder="House Name, Place, Post, District, PIN"></textarea>
          </div>

          <div class="field-box">
            <label>Student Photo Upload:</label>
            <input type="file" id="stPhoto" name="photo" accept="image/*">
          </div>

          <div class="field-box">
            <label>Aadhaar Card Upload (Image/PDF):</label>
            <input type="file" id="stAadhaarFile" name="aadhaar_doc" accept="image/*,.pdf">
          </div>

          <div class="batch-selection-wrapper full-span">
            <span class="batch-selection-title">Select Batches (First checked is Main Batch):</span>
            <div class="batch-checkbox-group">
              <% batches.forEach(b => { %>
                <label class="batch-chip">
                  <input type="checkbox" name="admBatches" value="<%= b.id %>" data-name="<%= b.name %>">
                  <span><%= b.name %></span>
                </label>
              <% }) %>
            </div>
          </div>
        </div>

        <div class="modal-actions">
          <button type="button" class="btn btn-secondary" onclick="closeNewAdmModal()">Cancel</button>
          <button type="button" class="btn btn-draft" onclick="submitAdmission('draft', false)">Save Draft</button>
          <button type="button" class="btn btn-primary" onclick="submitAdmission('pending', false)">Submit Admission</button>
          <button type="button" class="btn btn-success" onclick="submitAdmission('pending', true)">Submit & Print</button>
        </div>
      </form>
    </div>
  </div>

  <!-- 3. Edit Admission Modal -->
  <div id="editAdmModal" class="modal" onclick="if(event.target === this) closeEditAdmModal()">
    <div class="modal-content modal-lg">
      <div class="modal-header">
        <h3>Edit Admission Details</h3>
        <button type="button" class="modal-close" onclick="closeEditAdmModal()">×</button>
      </div>
      <input type="hidden" id="editAdmStatus">

      <div class="form-grid">
        <div class="field-box">
          <label>Admission No (Read-only):</label>
          <input type="text" id="editAdmNo" class="readonly-adm" readonly>
        </div>

        <div class="field-box">
          <label>Roll No:</label>
          <input type="number" id="editAdmRoll" min="1" placeholder="Roll No">
        </div>

        <div class="field-box">
          <label>Full Name: <span class="req-star">*</span></label>
          <input type="text" id="editAdmName" required>
        </div>

        <div class="field-box">
          <label>Date of Birth: <span class="req-star">*</span></label>
          <input type="date" id="editAdmDob" required>
        </div>

        <div class="field-box">
          <label>Father's Name:</label>
          <input type="text" id="editAdmFather" placeholder="Father's Name">
        </div>

        <div class="field-box">
          <label>Phone Number:</label>
          <input type="text" id="editAdmPhone" placeholder="Phone Number">
        </div>

        <div class="field-box">
          <label>Aadhaar Number:</label>
          <input type="text" id="editAdmAadhaar" maxlength="14" placeholder="12-digit ID Number">
        </div>

        <div class="field-box">
          <label>New Password (Leave blank to keep current):</label>
          <input type="password" id="editAdmPass" placeholder="Optional">
        </div>

        <div class="field-box full-span">
          <label>Full Address:</label>
          <textarea id="editAdmAddress" rows="2" placeholder="Full Address"></textarea>
        </div>

        <div class="field-box">
          <label>Update Photo (Optional): <span id="currentPhotoLink"></span></label>
          <input type="file" id="editAdmPhoto" accept="image/*">
        </div>

        <div class="field-box">
          <label>Update Aadhaar Doc (Optional): <span id="currentDocLink"></span></label>
          <input type="file" id="editAdmAadhaarFile" accept="image/*,.pdf">
        </div>

        <div class="batch-selection-wrapper full-span">
          <span class="batch-selection-title">Select Batches (First checked is Main Batch):</span>
          <div class="batch-checkbox-group">
            <% batches.forEach(b => { %>
              <label class="batch-chip">
                <input type="checkbox" name="editAdmBatches" value="<%= b.id %>">
                <span><%= b.name %></span>
              </label>
            <% }) %>
          </div>
        </div>
      </div>

      <div class="modal-actions">
        <button type="button" class="btn btn-secondary" onclick="closeEditAdmModal()">Cancel</button>
        <button type="button" class="btn btn-draft" onclick="saveAdmissionEdit('draft')">Save as Draft</button>
        <button type="button" class="btn btn-primary" onclick="saveAdmissionEdit('submit')">Update & Submit</button>
      </div>
    </div>
  </div>

  <!-- 4. Print Header & Footer Upload Modal -->
  <div id="brandingModal" class="modal" onclick="if(event.target === this) closeBrandingModal()">
    <div class="modal-content">
      <div class="modal-header">
        <h3>Admission Print Header & Footer</h3>
        <button type="button" class="modal-close" onclick="closeBrandingModal()">×</button>
      </div>
      <p class="branding-desc">
        Upload header and footer banner images to automatically include them in every Admission Form printout.
      </p>

      <div class="modal-form-body">
        <div>
          <label class="field-label">Header Image (Top Banner):</label>
          <input type="file" id="brandHeaderInput" accept="image/*" onchange="previewBrandImg(this, 'headerPreview')">
          <img id="headerPreview" class="preview-banner" src="<%= safeBranding.headerUrl %>" <%= safeBranding.headerUrl ? '' : 'hidden' %>>
        </div>

        <div style="margin-top: 8px;">
          <label class="field-label">Footer Image (Bottom Banner):</label>
          <input type="file" id="brandFooterInput" accept="image/*" onchange="previewBrandImg(this, 'footerPreview')">
          <img id="footerPreview" class="preview-banner" src="<%= safeBranding.footerUrl %>" <%= safeBranding.footerUrl ? '' : 'hidden' %>>
        </div>
      </div>

      <div class="modal-actions">
        <button type="button" class="btn btn-danger" onclick="clearBranding()">Remove Both</button>
        <button type="button" class="btn btn-secondary" onclick="closeBrandingModal()">Close</button>
        <button type="button" id="saveBrandBtn" class="btn btn-primary" onclick="saveBranding()">Save Header & Footer</button>
      </div>
    </div>
  </div>

  <!-- Safe JSON Data Store -->
  <script id="admissionsDataJson" type="application/json"><%- JSON.stringify(allStudents).replace(/</g, '\\u003c') %></script>
  <script id="brandingDataJson" type="application/json"><%- JSON.stringify(safeBranding).replace(/</g, '\\u003c') %></script>

  <script>
    const ADMISSIONS_LIST = JSON.parse(document.getElementById('admissionsDataJson').textContent || '[]');
    const BRANDING_CFG = JSON.parse(document.getElementById('brandingDataJson').textContent || '{}');
    const SERVER_HEADER_URL = BRANDING_CFG.headerUrl || '';
    const SERVER_FOOTER_URL = BRANDING_CFG.footerUrl || '';

    let selectedNewBatches = [];
    let selectedEditBatches = [];

    // Header Dropdown Menu Toggle
    function toggleHeaderMenu(e) {
      e.stopPropagation();
      const menu = document.getElementById('headerDropdownMenu');
      const btn = document.getElementById('headerMenuBtn');
      const isOpen = menu.classList.toggle('open');
      btn.classList.toggle('active', isOpen);
    }

    function closeHeaderMenu() {
      const menu = document.getElementById('headerDropdownMenu');
      const btn = document.getElementById('headerMenuBtn');
      if (menu) menu.classList.remove('open');
      if (btn) btn.classList.remove('active');
    }

    document.addEventListener('click', (e) => {
      const wrapper = document.getElementById('headerMenuWrapper');
      if (wrapper && !wrapper.contains(e.target)) {
        closeHeaderMenu();
      }
    });

    document.addEventListener('change', (e) => {
      if (e.target.name === 'admBatches') {
        const val = e.target.value;
        if (e.target.checked) {
          if (!selectedNewBatches.includes(val)) selectedNewBatches.push(val);
        } else {
          selectedNewBatches = selectedNewBatches.filter(item => item !== val);
        }
      } else if (e.target.name === 'editAdmBatches') {
        const val = e.target.value;
        if (e.target.checked) {
          if (!selectedEditBatches.includes(val)) selectedEditBatches.push(val);
        } else {
          selectedEditBatches = selectedEditBatches.filter(item => item !== val);
        }
      }
    });

    function openNewAdmModal() {
      selectedNewBatches = [];
      document.querySelectorAll('input[name="admBatches"]').forEach(cb => cb.checked = false);
      document.getElementById('newAdmModal').style.display = 'flex';
      setTimeout(() => document.getElementById('stName').focus(), 100);
    }

    function closeNewAdmModal() {
      document.getElementById('newAdmModal').style.display = 'none';
    }

    async function handleStatusDropdown(selectEl) {
      const admNo = selectEl.dataset.adm;
      const action = selectEl.value;
      const prevStatus = selectEl.getAttribute('data-current');

      try {
        const res = await fetch(`/api/admissions/${encodeURIComponent(admNo)}/status`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status: action })
        });
        const data = await res.json();
        if (data.success) {
          location.reload();
        } else {
          alert('Error: ' + (data.error || 'Failed to update status!'));
          selectEl.value = prevStatus;
        }
      } catch (err) {
        alert('Server error!');
        selectEl.value = prevStatus;
      }
    }

    async function submitAdmission(saveMode, autoPrint = false) {
      const full_name = document.getElementById('stName').value.trim();
      const dob = document.getElementById('stDob').value.trim();
      const roll_no = document.getElementById('stRoll').value.trim();
      const father_name = document.getElementById('stFather').value.trim();
      const phone = document.getElementById('stPhone').value.trim();
      const aadhaar_no = document.getElementById('stAadhaar').value.trim();
      const address = document.getElementById('stAddress').value.trim();

      if (!full_name || !dob) {
        return alert('Please enter both Full Name and Date of Birth!');
      }

      const batch_id = selectedNewBatches.join(',');
      if (saveMode === 'pending' && !batch_id) {
        return alert('Please select at least one batch to submit! (Or click Save Draft)');
      }

      const firstBatchCheckbox = selectedNewBatches.length > 0
        ? document.querySelector(`input[name="admBatches"][value="${selectedNewBatches[0]}"]`)
        : null;
      const mainBatchName = firstBatchCheckbox ? firstBatchCheckbox.getAttribute('data-name') : 'No Batch';

      const formData = new FormData();
      formData.append('full_name', full_name);
      formData.append('dob', dob);
      formData.append('roll_no', roll_no);
      formData.append('father_name', father_name);
      formData.append('phone', phone);
      formData.append('aadhaar_no', aadhaar_no);
      formData.append('address', address);
      formData.append('password', document.getElementById('stPass').value.trim());
      formData.append('batch_id', batch_id);
      formData.append('status', saveMode);

      const photoInput = document.getElementById('stPhoto');
      if (photoInput.files[0]) formData.append('photo', photoInput.files[0]);

      const aadhaarInput = document.getElementById('stAadhaarFile');
      if (aadhaarInput.files[0]) formData.append('aadhaar_doc', aadhaarInput.files[0]);

      try {
        const res = await fetch('/api/admissions', {
          method: 'POST',
          body: formData
        });
        const data = await res.json();
        if (data.success) {
          if (autoPrint) {
            printAdmissionRecord({
              admission_no: data.admission_no,
              roll_no: roll_no,
              full_name: full_name,
              dob: dob,
              father_name: father_name,
              phone: phone,
              aadhaar_no: aadhaar_no,
              address: address,
              main_batch_name: mainBatchName,
              status: saveMode,
              photo_file: ''
            });
            setTimeout(() => location.reload(), 600);
          } else {
            const msg = saveMode === 'draft'
              ? `Saved as Draft! Admission No: ${data.admission_no}`
              : `Admission submitted! Admission No: ${data.admission_no}\n(Select "Active" in Status dropdown to move student to Active List)`;
            alert(msg);
            location.reload();
          }
        } else {
          alert('Error: ' + (data.error || 'Failed to save admission!'));
        }
      } catch (err) {
        alert('Server connection failed!');
      }
    }

    function openEditAdmByIndex(idx) {
      const s = ADMISSIONS_LIST[Number(idx)];
      if (!s) return;

      let formattedDob = s.dob || '';
      if (formattedDob.includes('/')) {
        const parts = formattedDob.split('/');
        if (parts[2] && parts[2].length === 4) {
          formattedDob = `${parts[2]}-${parts[1].padStart(2, '0')}-${parts[0].padStart(2, '0')}`;
        }
      }

      document.getElementById('editAdmStatus').value = s.status || 'pending';
      document.getElementById('editAdmNo').value = s.admission_no || '';
      document.getElementById('editAdmRoll').value = s.roll_no || '';
      document.getElementById('editAdmName').value = s.full_name || '';
      document.getElementById('editAdmDob').value = formattedDob;
      document.getElementById('editAdmFather').value = s.father_name || '';
      document.getElementById('editAdmPhone').value = s.phone || '';
      document.getElementById('editAdmAadhaar').value = s.aadhaar_no || '';
      document.getElementById('editAdmAddress').value = s.address || '';
      document.getElementById('editAdmPass').value = '';
      document.getElementById('editAdmPhoto').value = '';
      document.getElementById('editAdmAadhaarFile').value = '';

      document.getElementById('currentPhotoLink').innerHTML = s.photo_file
        ? `(<a href="${s.photo_file}" target="_blank" class="doc-link">Current</a>)`
        : '';
      document.getElementById('currentDocLink').innerHTML = s.aadhaar_file
        ? `(<a href="${s.aadhaar_file}" target="_blank" class="doc-link">Current</a>)`
        : '';

      const assignedBatches = String(s.batch_id || '').split(',').map(b => b.trim()).filter(Boolean);
      selectedEditBatches = [...assignedBatches];
      document.querySelectorAll('input[name="editAdmBatches"]').forEach(cb => {
        cb.checked = assignedBatches.includes(String(cb.value).trim());
      });

      document.getElementById('editAdmModal').style.display = 'flex';
    }

    function closeEditAdmModal() {
      document.getElementById('editAdmModal').style.display = 'none';
    }

    async function saveAdmissionEdit(mode) {
      const admNo = document.getElementById('editAdmNo').value.trim();
      const currentStatus = document.getElementById('editAdmStatus').value;
      const full_name = document.getElementById('editAdmName').value.trim();
      const dob = document.getElementById('editAdmDob').value.trim();

      if (!full_name || !dob) {
        return alert('Full Name and Date of Birth are required!');
      }

      const batch_id = selectedEditBatches.join(',');
      let newStatus = currentStatus;
      if (mode === 'draft') {
        newStatus = 'draft';
      } else if (currentStatus === 'draft') {
        if (!batch_id) return alert('Please select at least one batch before submitting!');
        newStatus = 'pending';
      }

      const formData = new FormData();
      formData.append('full_name', full_name);
      formData.append('dob', dob);
      formData.append('roll_no', document.getElementById('editAdmRoll').value.trim());
      formData.append('father_name', document.getElementById('editAdmFather').value.trim());
      formData.append('phone', document.getElementById('editAdmPhone').value.trim());
      formData.append('aadhaar_no', document.getElementById('editAdmAadhaar').value.trim());
      formData.append('address', document.getElementById('editAdmAddress').value.trim());
      formData.append('password', document.getElementById('editAdmPass').value.trim());
      formData.append('batch_id', batch_id);
      formData.append('status', newStatus);

      const photoInput = document.getElementById('editAdmPhoto');
      if (photoInput.files[0]) formData.append('photo', photoInput.files[0]);

      const aadhaarInput = document.getElementById('editAdmAadhaarFile');
      if (aadhaarInput.files[0]) formData.append('aadhaar_doc', aadhaarInput.files[0]);

      try {
        const res = await fetch(`/api/admissions/${encodeURIComponent(admNo)}`, {
          method: 'PUT',
          body: formData
        });
        const data = await res.json();
        if (data.success) location.reload();
        else alert('Error: ' + (data.error || 'Failed to update admission!'));
      } catch (err) {
        alert('Server error while updating!');
      }
    }

    function openBrandingModal() {
      const savedHeader = localStorage.getItem('adm_print_header') || SERVER_HEADER_URL;
      const savedFooter = localStorage.getItem('adm_print_footer') || SERVER_FOOTER_URL;
      const hPrev = document.getElementById('headerPreview');
      const fPrev = document.getElementById('footerPreview');

      if (savedHeader) { hPrev.src = savedHeader; hPrev.hidden = false; }
      if (savedFooter) { fPrev.src = savedFooter; fPrev.hidden = false; }

      document.getElementById('brandingModal').style.display = 'flex';
    }

    function closeBrandingModal() {
      document.getElementById('brandingModal').style.display = 'none';
    }

    function previewBrandImg(input, imgId) {
      if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = (e) => {
          const img = document.getElementById(imgId);
          img.src = e.target.result;
          img.hidden = false;
          if (imgId === 'headerPreview') localStorage.setItem('adm_print_header', e.target.result);
          if (imgId === 'footerPreview') localStorage.setItem('adm_print_footer', e.target.result);
        };
        reader.readAsDataURL(input.files[0]);
      }
    }

    async function saveBranding() {
      const hFile = document.getElementById('brandHeaderInput').files[0];
      const fFile = document.getElementById('brandFooterInput').files[0];
      const btn = document.getElementById('saveBrandBtn');

      if (!hFile && !fFile) {
        alert('Header & Footer preferences saved!');
        closeBrandingModal();
        return;
      }

      const formData = new FormData();
      if (hFile) formData.append('print_header', hFile);
      if (fFile) formData.append('print_footer', fFile);

      btn.disabled = true;
      btn.innerText = 'Uploading...';

      try {
        const res = await fetch('/api/admission-branding', {
          method: 'POST',
          body: formData
        });
        const data = await res.json();
        if (data.success) {
          alert('Header & Footer uploaded successfully!');
          closeBrandingModal();
        } else {
          alert('Error: ' + data.error);
        }
      } catch (err) {
        alert('Saved locally in browser!');
        closeBrandingModal();
      } finally {
        btn.disabled = false;
        btn.innerText = 'Save Header & Footer';
      }
    }

    function clearBranding() {
      localStorage.removeItem('adm_print_header');
      localStorage.removeItem('adm_print_footer');
      document.getElementById('headerPreview').src = '';
      document.getElementById('headerPreview').hidden = true;
      document.getElementById('footerPreview').src = '';
      document.getElementById('footerPreview').hidden = true;
      alert('Header & Footer removed!');
    }

    function printAdmByIndex(idx) {
      const s = ADMISSIONS_LIST[Number(idx)];
      if (!s) return;
      printAdmissionRecord(s);
    }

    function escapeHtml(str) {
      return String(str || '-')
        .replace(/&/g, '&')
        .replace(/</g, '<')
        .replace(/>/g, '>')
        .replace(/"/g, '"');
    }

    function printAdmissionRecord(info) {
      const headerImg = localStorage.getItem('adm_print_header') || SERVER_HEADER_URL;
      const footerImg = localStorage.getItem('adm_print_footer') || SERVER_FOOTER_URL;
      const today = new Date().toLocaleDateString('en-GB');

      const printWin = window.open('', '_blank', 'width=820,height=950');
      if (!printWin) return alert('Please allow pop-ups in your browser to print!');

      const htmlParts = [
        '<!DOCTYPE html><html><head><title>Admission Form - ' + escapeHtml(info.admission_no) + '</title>',
        '<style>',
        '@page { size: A4; margin: 12mm; }',
        'body { font-family: Arial, sans-serif; color: #0f172a; margin: 0; padding: 0; }',
        '.page-wrap { display: flex; flex-direction: column; min-height: 270mm; justify-content: space-between; }',
        '.header-banner img, .footer-banner img { width: 100%; max-height: 115px; object-fit: contain; display: block; }',
        '.default-header { text-align: center; border-bottom: 2px solid #1e293b; padding-bottom: 10px; margin-bottom: 16px; }',
        '.form-title { text-align: center; font-size: 16px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; background: #f1f5f9; padding: 8px; border: 1px solid #cbd5e1; margin: 12px 0 18px; }',
        '.top-meta { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px; }',
        '.photo-box { width: 110px; height: 130px; border: 1px solid #94a3b8; display: flex; align-items: center; justify-content: center; font-size: 11px; color: #64748b; overflow: hidden; }',
        '.photo-box img { width: 100%; height: 100%; object-fit: cover; }',
        'table.details { width: 100%; border-collapse: collapse; font-size: 13.5px; }',
        'table.details td { padding: 10px 12px; border: 1px solid #cbd5e1; }',
        'table.details td.lbl { width: 32%; font-weight: 700; background: #f8fafc; color: #334155; }',
        '.sig-row { display: flex; justify-content: space-between; margin-top: 45px; padding: 0 20px; font-size: 13px; font-weight: 600; }',
        '.sig-line { border-top: 1px solid #334155; padding-top: 6px; width: 180px; text-align: center; }',
        '</style></head><body><div class="page-wrap"><div>',
        headerImg
          ? '<div class="header-banner"><img src="' + headerImg + '" alt="Header"></div>'
          : '<div class="default-header"><h2 style="margin:0;">STUDENT ADMISSION FORM</h2></div>',
        '<div class="form-title">Student Admission Record</div>',
        '<div class="top-meta"><div>',
        '<p style="margin:4px 0;font-size:14px;"><strong>Admission No:</strong> ' + escapeHtml(info.admission_no) + '</p>',
        '<p style="margin:4px 0;font-size:14px;"><strong>Main Batch:</strong> ' + escapeHtml(info.main_batch_name || info.batch_name) + '</p>',
        '<p style="margin:4px 0;font-size:13px;color:#475569;"><strong>Date:</strong> ' + today + '</p>',
        '</div><div class="photo-box">',
        info.photo_file ? '<img src="' + info.photo_file + '" alt="Student Photo">' : 'Passport Photo',
        '</div></div>',
        '<table class="details">',
        '<tr><td class="lbl">Full Name</td><td><strong>' + escapeHtml(info.full_name) + '</strong></td></tr>',
        '<tr><td class="lbl">Roll Number</td><td>' + escapeHtml(info.roll_no) + '</td></tr>',
        '<tr><td class="lbl">Date of Birth</td><td>' + escapeHtml(info.dob) + '</td></tr>',
        '<tr><td class="lbl">Father\'s Name</td><td>' + escapeHtml(info.father_name) + '</td></tr>',
        '<tr><td class="lbl">Phone Number</td><td>' + escapeHtml(info.phone) + '</td></tr>',
        '<tr><td class="lbl">Aadhaar Number</td><td>' + escapeHtml(info.aadhaar_no) + '</td></tr>',
        '<tr><td class="lbl">Full Address</td><td>' + escapeHtml(info.address) + '</td></tr>',
        '<tr><td class="lbl">Admission Status</td><td style="text-transform:uppercase;font-weight:700;">' + escapeHtml(info.status) + '</td></tr>',
        '</table>',
        '<div class="sig-row"><div class="sig-line">Parent / Student Signature</div><div class="sig-line">Authorized Signature</div></div>',
        '</div>',
        footerImg ? '<div class="footer-banner"><img src="' + footerImg + '" alt="Footer"></div>' : '',
        '</div></body></html>'
      ];

      printWin.document.open();
      printWin.document.write(htmlParts.join(''));
      printWin.document.close();

      printWin.onload = () => {
        setTimeout(() => printWin.print(), 250);
      };
    }
  </script>
</body>
</html>