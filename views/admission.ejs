    // Auto-Fill District & State from 6-digit Indian PIN Code
    async function lookupPinCode(pinVal, placeId, distId, stateId, statusId) {
      const cleanPin = String(pinVal || '').replace(/\D/g, '');
      const statusEl = document.getElementById(statusId);
      if (cleanPin.length !== 6) {
        if (statusEl) statusEl.innerText = '';
        return;
      }

      if (statusEl) statusEl.innerText = 'Fetching...';
      try {
        const res = await fetch(`https://api.postalpincode.in/pincode/${cleanPin}`);
        const data = await res.json();
        if (Array.isArray(data) && data[0]?.Status === 'Success' && data[0]?.PostOffice?.length > 0) {
          const po = data[0].PostOffice[0];
          const placeEl = document.getElementById(placeId);
          if (placeEl && !placeEl.value.trim()) {
            placeEl.value = po.Name || '';
          }
          document.getElementById(distId).value = po.District || '';
          document.getElementById(stateId).value = po.State || '';
          if (statusEl) statusEl.innerText = '✓ Found';
        } else {
          if (statusEl) statusEl.innerText = 'Invalid PIN';
        }
      } catch (err) {
        if (statusEl) statusEl.innerText = '';
      }
    }

