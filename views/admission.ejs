<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Student Admissions</title>
  <link rel="stylesheet" href="/student.css">
  <link rel="stylesheet" href="/admission.css">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
</head>
<body>

  <%
    const safeBranding = (typeof branding !== 'undefined' && branding) ? branding : { headerUrl: '', footerUrl: '' };
  %>

  <div class="container">
    <div class="top-bar">
      <h1 class="top-bar-title">Student Admissions</h1>

      <div class="top-bar-actions-group">
        <a href="/dashboard" class="btn-header-icon" title="Back to Dashboard" aria-label="Back to Dashboard">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 12H5"></path>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
        </a>

        <div class="header-menu-wrapper" id="headerMenuWrapper">
          <button type="button" class="btn-header-icon" id="headerMenuBtn" onclick="toggleHeaderMenu(event)" title="Options" aria-label="Options Menu">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="5" r="1.5"></circle>
              <circle cx="12" cy="12" r="1.5"></circle>
              <circle cx="12" cy="19" r="1.5"></circle>
            </svg>
          </button>

          <div class="header-dropdown-menu" id="headerDropdownMenu">
            <button type="button" class="menu-drop-item" onclick="closeHeaderMenu(); openNewAdmModal();">
              <span>+ New Admission</span>
            </button>
            <a href="/students" class="menu-drop-item">
              <span>Active Student List →</span>
            </a>
            <button type="button" class="menu-drop-item" onclick="closeHeaderMenu(); goToIdCardsPage();">
              <span>ID Card Studio →</span>
            </button>
            <button type="button" class="menu-drop-item" onclick="closeHeaderMenu(); openBrandingModal();">
              <span>Print Header / Footer</span>
            </button>
            <button type="button" class="menu-drop-item" onclick="closeHeaderMenu(); downloadBlankAdmissionForm();">
              <span>Download Blank Form</span>
            </button>
            <div class="menu-divider"></div>
            <button type="button" class="menu-drop-item" onclick="closeHeaderMenu(); openAdmExportModal('csv');">
              <span>Download CSV</span>
            </button>
            <button type="button" class="menu-drop-item" onclick="closeHeaderMenu(); openAdmExportModal('pdf');">
              <span>Download PDF</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Search Bar Card -->
    <div class="card" style="padding: 14px 16px; margin-bottom: 16px;">
      <div class="toolbar">
        <input type="text"
               id="admissionSearch"
               class="search-input"
               autocomplete="off"
               readonly
               onfocus="this.removeAttribute('readonly');"
               placeholder="Search by Name, Adm No, Father's Name, Place, Phone, or Status..."
               onkeyup="filterAdmissionTable()">
      </div>
    </div>

    <!-- 1. All Admissions Table -->
    <div class="card">
      <h3>All Admissions (<span id="visibleAdmCount"><%= allStudents.length %></span>)</h3>
      <p class="card-subtitle">Only active students appear in the Active Student List & Attendance.</p>

      <div class="table-responsive">
        <table id="admissionsTable">
          <thead>
            <tr>
              <th class="chk-col"><input type="checkbox" id="selectAllAdmissions" onclick="toggleSelectAllAdm(this)" title="Select All"></th>
              <th>Photo</th>
              <th>Adm No</th>
              <th>Student & Father</th>
              <th>DOB</th>
              <th>Aadhaar / Docs</th>
              <th>Status</th>
              <th style="text-align: center;">Action</th>
            </tr>
          </thead>
          <tbody>
            <% if (allStudents.length === 0) { %>
              <tr>
                <td colspan="8" class="empty-row">
                  No admission records found. Tap the menu icon (<strong>⋮</strong>) above to add a new admission.
                </td>
              </tr>
            <% } %>

            <% allStudents.forEach((s, index) => { %>
              <tr class="adm-row"
                  data-index="<%= index %>"
                  data-search="<%= `${s.admission_no || ''} ${s.roll_no || ''} ${s.full_name || ''} ${s.father_name || ''} ${s.place || ''} ${s.phone || ''} ${s.guardian_phone || ''} ${s.status || ''}`.toLowerCase() %>">
                <td class="chk-col" data-label="Select">
                  <input type="checkbox" class="adm-select-chk" value="<%= index %>">
                </td>
                <td data-label="Photo">
                  <% if (s.photo_file) { %>
                    <a href="<%= s.photo_file %>" target="_blank">
                      <img src="<%= s.photo_file %>" alt="Photo" class="student-thumb">
                    </a>
                  <% } else { %>
                    <span class="no-photo-tag">No<br>Photo</span>
                  <% } %>
                </td>
                <td data-label="Adm No"><strong><%= s.admission_no || '-' %></strong></td>
                <td data-label="Student">
                  <div>
                    <strong><%= s.full_name %></strong>
                    <span class="student-meta-sub">Father: <%= s.father_name || '-' %></span>
                  </div>
                </td>
                <td data-label="DOB"><%= s.dob || '-' %></td>
                <td data-label="Aadhaar / Docs">
                  <div>
                    <div class="aadhaar-text"><%= s.aadhaar_no || '-' %></div>
                    <% if (s.aadhaar_file) { %>
                      <a href="<%= s.aadhaar_file %>" target="_blank" class="doc-link">View Document ↗</a>
                    <% } %>
                  </div>
                </td>
                <td data-label="Status">
                  <select class="status-select st-<%= s.status %>"
                          data-current="<%= s.status %>"
                          data-adm="<%= s.admission_no %>"
                          onchange="handleStatusDropdown(this)">
                    <% if (s.status === 'draft') { %>
                      <option value="draft" selected>Draft</option>
                    <% } %>
                    <option value="pending" <%= s.status === 'pending' ? 'selected' : '' %>>Not Active</option>
                    <option value="active" <%= s.status === 'active' ? 'selected' : '' %>>Active</option>
                  </select>
                </td>
                <td data-label="Action">
                  <div class="action-btns">
                    <button type="button" class="btn btn-sm btn-edit-std" data-index="<%= index %>" onclick="openEditAdmByIndex(this.dataset.index)">
                      Edit
                    </button>
                    <a href="/id-cards?adms=<%= encodeURIComponent(s.admission_no) %>" class="btn btn-sm btn-primary">
                      ID Card
                    </a>
                    <button type="button" class="btn btn-sm btn-secondary" data-index="<%= index %>" onclick="printAdmByIndex(this.dataset.index)">
                      Print
                    </button>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Column Selection Modal for Export (CSV / PDF) -->
  <div id="admExportModal" class="modal" onclick="if(event.target === this) closeAdmExportModal()">
    <div class="modal-content" style="max-width: 460px;">
      <div class="modal-header">
        <h3 id="admExportTitle">Select Columns to Download</h3>
        <button type="button" class="modal-close" onclick="closeAdmExportModal()">×</button>
      </div>
      <p id="admExportSelectedCount" style="font-size: 13px; color: #64748b; margin-bottom: 6px;"></p>
      <input type="hidden" id="admExportFormatType">

      <div class="col-select-grid">
        <label class="col-chk-item">
          <input type="checkbox" name="admExportCols" value="admission_no" data-label="Adm No" checked>
          <span>Admission No</span>
        </label>
        <label class="col-chk-item">
          <input type="checkbox" name="admExportCols" value="roll_no" data-label="Roll No" checked>
          <span>Roll No</span>
        </label>
        <label class="col-chk-item">
          <input type="checkbox" name="admExportCols" value="full_name" data-label="Full Name" checked>
          <span>Student Name</span>
        </label>
        <label class="col-chk-item">
          <input type="checkbox" name="admExportCols" value="father_name" data-label="Father Name" checked>
          <span>Father's Name</span>
        </label>
        <label class="col-chk-item">
          <input type="checkbox" name="admExportCols" value="dob" data-label="DOB" checked>
          <span>Date of Birth</span>
        </label>
        <label class="col-chk-item">
          <input type="checkbox" name="admExportCols" value="phone" data-label="Student Phone" checked>
          <span>Student Phone</span>
        </label>
        <label class="col-chk-item">
          <input type="checkbox" name="admExportCols" value="guardian_phone" data-label="Guardian Phone" checked>
          <span>Guardian Phone</span>
        </label>
        <label class="col-chk-item">
          <input type="checkbox" name="admExportCols" value="aadhaar_no" data-label="Aadhaar No">
          <span>Aadhaar Number</span>
        </label>
        <label class="col-chk-item">
          <input type="checkbox" name="admExportCols" value="school_class" data-label="School Class" checked>
          <span>School Class</span>
        </label>
        <label class="col-chk-item">
          <input type="checkbox" name="admExportCols" value="madrasa_class" data-label="Madrasa Class" checked>
          <span>Madrasa Class</span>
        </label>
        <label class="col-chk-item">
          <input type="checkbox" name="admExportCols" value="prev_institution" data-label="Prev Institution">
          <span>Prev. Institution</span>
        </label>
        <label class="col-chk-item">
          <input type="checkbox" name="admExportCols" value="place" data-label="Place" checked>
          <span>Place</span>
        </label>
        <label class="col-chk-item">
          <input type="checkbox" name="admExportCols" value="pin" data-label="PIN">
          <span>PIN Code</span>
        </label>
        <label class="col-chk-item">
          <input type="checkbox" name="admExportCols" value="district" data-label="District">
          <span>District</span>
        </label>
        <label class="col-chk-item">
          <input type="checkbox" name="admExportCols" value="state" data-label="State">
          <span>State</span>
        </label>
        <label class="col-chk-item">
          <input type="checkbox" name="admExportCols" value="address" data-label="Address">
          <span>Full Address</span>
        </label>
        <label class="col-chk-item">
          <input type="checkbox" name="admExportCols" value="status" data-label="Status" checked>
          <span>Status</span>
        </label>
      </div>

      <div class="modal-actions">
        <button type="button" class="btn btn-secondary" onclick="closeAdmExportModal()">Cancel</button>
        <button type="button" id="confirmAdmExportBtn" class="btn btn-primary" onclick="executeAdmExport()">Download</button>
      </div>
    </div>
  </div>

  <!-- 2. New Admission Popup Modal (No Batch Checkboxes) -->
  <div id="newAdmModal" class="modal" onclick="if(event.target === this) closeNewAdmModal()">
    <div class="modal-content modal-lg">
      <div class="modal-header">
        <h3>New Student Admission</h3>
        <button type="button" class="modal-close" onclick="closeNewAdmModal()">×</button>
      </div>

      <form id="admissionForm" enctype="multipart/form-data">
        <div class="form-grid">
          <div class="field-box">
            <label>Auto Admission No:</label>
            <input type="text" id="admNo" value="<%= nextAdmissionNo %>" class="readonly-adm" readonly>
          </div>

          <div class="field-box">
            <label>Roll No (Optional):</label>
            <input type="number" id="stRoll" name="roll_no" placeholder="Roll No (e.g., 1)" min="1">
          </div>

          <div class="field-box">
            <label>Full Name: <span class="req-star">*</span></label>
            <input type="text" id="stName" name="full_name" placeholder="Student Full Name" required>
          </div>

          <div class="field-box">
            <label>Date of Birth: <span class="req-star">*</span></label>
            <input type="date" id="stDob" name="dob" required>
          </div>

          <div class="field-box">
            <label>Father's Name:</label>
            <input type="text" id="stFather" name="father_name" placeholder="Father's Name">
          </div>

          <div class="field-box">
            <label>Aadhaar Number:</label>
            <input type="text" id="stAadhaar" name="aadhaar_no" placeholder="12-digit Aadhaar Number" maxlength="14">
          </div>

          <div class="field-box">
            <label>Student Phone Number:</label>
            <input type="text" id="stPhone" name="phone" placeholder="Student Phone Number">
          </div>

          <div class="field-box">
            <label>Parent / Guardian Phone Number:</label>
            <input type="text" id="stGuardianPhone" name="guardian_phone" placeholder="Parent / Guardian Phone">
          </div>

          <div class="field-box">
            <label>PIN Code (Auto-fills District & State): <span id="newPinStatus" style="font-size:11px; color:#2563eb;"></span></label>
            <input type="text" id="stPin" name="pin" placeholder="6-digit PIN Code" maxlength="6" oninput="lookupPinCode(this.value, 'stPlace', 'stDistrict', 'stState', 'newPinStatus')">
          </div>

          <div class="field-box">
            <label>Place:</label>
            <input type="text" id="stPlace" name="place" placeholder="Place / Locality">
          </div>

          <div class="field-box">
            <label>District:</label>
            <input type="text" id="stDistrict" name="district" placeholder="District">
          </div>

          <div class="field-box">
            <label>State:</label>
            <input type="text" id="stState" name="state" placeholder="State">
          </div>

          <div class="field-box full-span">
            <label>House Name / Full Address:</label>
            <textarea id="stAddress" name="address" rows="2" placeholder="House Name, Post Office, Street"></textarea>
          </div>

          <!-- Muthallim Previous Study Toggle before Madrasa Class -->
          <div class="field-box">
            <label>Studied as Muthallim Previously?</label>
            <select id="stIsMuthallim" name="is_muthallim" onchange="toggleMuthallimFields('stIsMuthallim', 'newMuthallimBox')">
              <option value="no" selected>No (Fresh)</option>
              <option value="yes">Yes (Studied Previously)</option>
            </select>
          </div>

          <div class="field-box">
            <label>Login Password:</label>
            <input type="password" id="stPass" name="password" placeholder="Defaults to Admission No if empty">
          </div>

          <div id="newMuthallimBox" class="form-grid full-span" style="display: none; background: #f8fafc; padding: 10px; border-radius: 8px; border: 1px dashed #94a3b8;">
            <div class="field-box">
              <label>Previous Institution Name:</label>
              <input type="text" id="stPrevInst" name="prev_institution" placeholder="Name of Previous Madrasa / Dars / College">
            </div>
            <div class="field-box">
              <label>Institution Place:</label>
              <input type="text" id="stPrevPlace" name="prev_place" placeholder="Location / Place of Institution">
            </div>
          </div>

          <div class="field-box">
            <label>Current Madrasa Class:</label>
            <input type="text" id="stMadrasaClass" name="madrasa_class" placeholder="e.g., Class 5 / Hifz">
          </div>

          <div class="field-box">
            <label>Current School Class:</label>
            <input type="text" id="stSchoolClass" name="school_class" placeholder="e.g., 5th Standard / Plus One">
          </div>

          <div class="field-box">
            <label>Student Photo Upload:</label>
            <input type="file" id="stPhoto" name="photo" accept="image/*">
          </div>

          <div class="field-box">
            <label>Aadhaar Document Upload (Image/PDF):</label>
            <input type="file" id="stAadhaarFile" name="aadhaar_doc" accept="image/*,.pdf">
          </div>
        </div>

        <div class="modal-actions">
          <button type="button" class="btn btn-secondary" onclick="closeNewAdmModal()">Cancel</button>
          <button type="button" class="btn btn-draft" onclick="submitAdmission('draft', false)">Save Draft</button>
          <button type="button" class="btn btn-primary" onclick="submitAdmission('pending', false)">Submit Admission</button>
          <button type="button" class="btn btn-success" onclick="submitAdmission('pending', true)">Submit & Print</button>
        </div>
      </form>
    </div>
  </div>

  <!-- 3. Edit Admission Modal -->
  <div id="editAdmModal" class="modal" onclick="if(event.target === this) closeEditAdmModal()">
    <div class="modal-content modal-lg">
      <div class="modal-header">
        <h3>Edit Admission Details</h3>
        <button type="button" class="modal-close" onclick="closeEditAdmModal()">×</button>
      </div>
      <input type="hidden" id="editAdmStatus">

      <div class="form-grid">
        <div class="field-box">
          <label>Admission No (Read-only):</label>
          <input type="text" id="editAdmNo" class="readonly-adm" readonly>
        </div>

        <div class="field-box">
          <label>Roll No:</label>
          <input type="number" id="editAdmRoll" min="1" placeholder="Roll No">
        </div>

        <div class="field-box">
          <label>Full Name: <span class="req-star">*</span></label>
          <input type="text" id="editAdmName" required>
        </div>

        <div class="field-box">
          <label>Date of Birth: <span class="req-star">*</span></label>
          <input type="date" id="editAdmDob" required>
        </div>

        <div class="field-box">
          <label>Father's Name:</label>
          <input type="text" id="editAdmFather" placeholder="Father's Name">
        </div>

        <div class="field-box">
          <label>Aadhaar Number:</label>
          <input type="text" id="editAdmAadhaar" maxlength="14" placeholder="12-digit Aadhaar Number">
        </div>

        <div class="field-box">
          <label>Student Phone Number:</label>
          <input type="text" id="editAdmPhone" placeholder="Student Phone Number">
        </div>

        <div class="field-box">
          <label>Parent / Guardian Phone Number:</label>
          <input type="text" id="editAdmGuardianPhone" placeholder="Parent / Guardian Phone">
        </div>

        <div class="field-box">
          <label>PIN Code (Auto-fills District & State): <span id="editPinStatus" style="font-size:11px; color:#2563eb;"></span></label>
          <input type="text" id="editAdmPin" placeholder="6-digit PIN Code" maxlength="6" oninput="lookupPinCode(this.value, 'editAdmPlace', 'editAdmDistrict', 'editAdmState', 'editPinStatus')">
        </div>

        <div class="field-box">
          <label>Place:</label>
          <input type="text" id="editAdmPlace" placeholder="Place / Locality">
        </div>

        <div class="field-box">
          <label>District:</label>
          <input type="text" id="editAdmDistrict" placeholder="District">
        </div>

        <div class="field-box">
          <label>State:</label>
          <input type="text" id="editAdmState" placeholder="State">
        </div>

        <div class="field-box full-span">
          <label>House Name / Full Address:</label>
          <textarea id="editAdmAddress" rows="2" placeholder="Full Address"></textarea>
        </div>

        <div class="field-box">
          <label>Studied as Muthallim Previously?</label>
          <select id="editAdmIsMuthallim" onchange="toggleMuthallimFields('editAdmIsMuthallim', 'editMuthallimBox')">
            <option value="no">No (Fresh)</option>
            <option value="yes">Yes (Studied Previously)</option>
          </select>
        </div>

        <div class="field-box">
          <label>New Password (Leave blank to keep current):</label>
          <input type="password" id="editAdmPass" placeholder="Optional">
        </div>

        <div id="editMuthallimBox" class="form-grid full-span" style="display: none; background: #f8fafc; padding: 10px; border-radius: 8px; border: 1px dashed #94a3b8;">
          <div class="field-box">
            <label>Previous Institution Name:</label>
            <input type="text" id="editAdmPrevInst" placeholder="Name of Previous Institution">
          </div>
          <div class="field-box">
            <label>Institution Place:</label>
            <input type="text" id="editAdmPrevPlace" placeholder="Location / Place">
          </div>
        </div>

        <div class="field-box">
          <label>Current Madrasa Class:</label>
          <input type="text" id="editAdmMadrasaClass" placeholder="e.g., Class 5">
        </div>

        <div class="field-box">
          <label>Current School Class:</label>
          <input type="text" id="editAdmSchoolClass" placeholder="e.g., 5th Standard">
        </div>

        <div class="field-box">
          <label>Update Photo (Optional): <span id="currentPhotoLink"></span></label>
          <input type="file" id="editAdmPhoto" accept="image/*">
        </div>

        <div class="field-box">
          <label>Update Aadhaar Doc (Optional): <span id="currentDocLink"></span></label>
          <input type="file" id="editAdmAadhaarFile" accept="image/*,.pdf">
        </div>

        <div class="batch-selection-wrapper full-span">
          <span class="batch-selection-title">Assign Batches (Required before activating student):</span>
          <div class="batch-checkbox-group">
            <% batches.forEach(b => { %>
              <label class="batch-chip">
                <input type="checkbox" name="editAdmBatches" value="<%= b.id %>">
                <span><%= b.name %></span>
              </label>
            <% }) %>
          </div>
        </div>
      </div>

      <div class="modal-actions">
        <button type="button" class="btn btn-secondary" onclick="closeEditAdmModal()">Cancel</button>
        <button type="button" class="btn btn-draft" onclick="saveAdmissionEdit('draft')">Save as Draft</button>
        <button type="button" class="btn btn-primary" onclick="saveAdmissionEdit('submit')">Update & Submit</button>
      </div>
    </div>
  </div>

  <!-- 4. Print Header & Footer Upload Modal -->
  <div id="brandingModal" class="modal" onclick="if(event.target === this) closeBrandingModal()">
    <div class="modal-content">
      <div class="modal-header">
        <h3>Admission Print Header & Footer</h3>
        <button type="button" class="modal-close" onclick="closeBrandingModal()">×</button>
      </div>
      <p class="branding-desc">
        Upload header and footer banner images to automatically include them in every filled & blank Admission Form printout.
      </p>

      <div class="modal-form-body">
        <div>
          <label class="field-label">Header Image (Top Banner):</label>
          <input type="file" id="brandHeaderInput" accept="image/*" onchange="previewBrandImg(this, 'headerPreview')">
          <img id="headerPreview" class="preview-banner" src="<%= safeBranding.headerUrl %>" <%= safeBranding.headerUrl ? '' : 'hidden' %>>
        </div>

        <div style="margin-top: 8px;">
          <label class="field-label">Footer Image (Bottom Banner):</label>
          <input type="file" id="brandFooterInput" accept="image/*" onchange="previewBrandImg(this, 'footerPreview')">
          <img id="footerPreview" class="preview-banner" src="<%= safeBranding.footerUrl %>" <%= safeBranding.footerUrl ? '' : 'hidden' %>>
        </div>
      </div>

      <div class="modal-actions">
        <button type="button" class="btn btn-danger" onclick="clearBranding()">Remove Both</button>
        <button type="button" class="btn btn-secondary" onclick="closeBrandingModal()">Close</button>
        <button type="button" id="saveBrandBtn" class="btn btn-primary" onclick="saveBranding()">Save Header & Footer</button>
      </div>
    </div>
  </div>

  <!-- Safe JSON Data Store -->
  <script id="admissionsDataJson" type="application/json"><%- JSON.stringify(allStudents).replace(/</g, '\\u003c') %></script>
  <script id="brandingDataJson" type="application/json"><%- JSON.stringify(safeBranding).replace(/</g, '\\u003c') %></script>

  <script>
    const ADMISSIONS_LIST = JSON.parse(document.getElementById('admissionsDataJson').textContent || '[]');
    const BRANDING_CFG = JSON.parse(document.getElementById('brandingDataJson').textContent || '{}');
    const SERVER_HEADER_URL = BRANDING_CFG.headerUrl || '';
    const SERVER_FOOTER_URL = BRANDING_CFG.footerUrl || '';

    let selectedEditBatches = [];

    window.addEventListener('DOMContentLoaded', () => {
      const searchInput = document.getElementById('admissionSearch');
      if (searchInput) searchInput.blur();
    });

    // Toggle Muthallim Previous Institution Fields
