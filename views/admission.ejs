    function executeAdmExport() {
      const format = document.getElementById('admExportFormatType').value;
      const selectedColInputs = Array.from(document.querySelectorAll('input[name="admExportCols"]:checked'));

      if (selectedColInputs.length === 0) {
        return alert('Please select at least one column to download!');
      }

      const selectedCols = selectedColInputs.map(cb => ({
        key: cb.value,
        label: cb.getAttribute('data-label')
      }));

      const selectedRecords = Array.from(document.querySelectorAll('.adm-select-chk:checked'))
        .map(chk => ADMISSIONS_LIST[Number(chk.value)])
        .filter(Boolean);

      const today = new Date().toISOString().split('T')[0];

      if (format === 'csv') {
        const headers = selectedCols.map(c => c.label);
        const csvRows = [headers.join(',')];

        selectedRecords.forEach(item => {
          const values = selectedCols.map(c => {
            let val = item[c.key] || '';
            if (c.key === 'status') val = String(val).toUpperCase();
            return `"${String(val).replace(/"/g, '""')}"`;
          });
          csvRows.push(values.join(','));
        });

        const blob = new Blob([csvRows.join('\n')], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = url;
        link.download = `Admissions_List_${today}.csv`;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        URL.revokeObjectURL(url);
        closeAdmExportModal();
      } else if (format === 'pdf') {
        if (!window.jspdf) {
          return alert('PDF library is loading. Please check your internet connection and try again.');
        }

        const { jsPDF } = window.jspdf;
        const isLandscape = selectedCols.length > 6;
        const doc = new jsPDF(isLandscape ? 'l' : 'p', 'mm', 'a4');

        doc.setFontSize(15);
        doc.setTextColor(15, 23, 42);
        doc.text('Student Admissions List', 14, 16);

        doc.setFontSize(9.5);
        doc.setTextColor(100, 116, 139);
        doc.text(`Generated Date: ${today}   |   Total Records: ${selectedRecords.length}`, 14, 22);

        const headRow = ['#', ...selectedCols.map(c => c.label)];
        const bodyRows = selectedRecords.map((item, idx) => [
          idx + 1,
          ...selectedCols.map(c => {
            let val = item[c.key] || '-';
            if (c.key === 'status') val = String(val).toUpperCase();
            return val;
          })
        ]);

        doc.autoTable({
          startY: 27,
          head: [headRow],
          body: bodyRows,
          theme: 'grid',
          styles: {
            fontSize: 8.5,
            cellPadding: 3,
            textColor: [30, 41, 59],
            lineColor: [203, 213, 225],
            lineWidth: 0.2
          },
          headStyles: {
            fillColor: [37, 99, 235],
            textColor: 255,
            fontStyle: 'bold',
            halign: 'center'
          },
          columnStyles: {
            0: { halign: 'center', cellWidth: 10 }
          },
          alternateRowStyles: {
            fillColor: [248, 250, 252]
          }
        });

        doc.save(`Admissions_List_${today}.pdf`);
        closeAdmExportModal();
      }
    }

