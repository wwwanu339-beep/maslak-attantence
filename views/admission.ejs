      const prev_institution = document.getElementById('stPrevInst').value.trim();
      const prev_place = document.getElementById('stPrevPlace').value.trim();
      const school_class = document.getElementById('stSchoolClass').value.trim();
      const madrasa_class = document.getElementById('stMadrasaClass').value.trim();
      const place = document.getElementById('stPlace').value.trim();
      const pin = document.getElementById('stPin').value.trim();
      const district = document.getElementById('stDistrict').value.trim();
      const state = document.getElementById('stState').value.trim();
      const address = document.getElementById('stAddress').value.trim();

      if (!full_name || !dob) {
        return alert('Please enter both Full Name and Date of Birth!');
      }

      const formData = new FormData();
      formData.append('full_name', full_name);
      formData.append('dob', dob);
      formData.append('roll_no', roll_no);
      formData.append('father_name', father_name);
      formData.append('phone', phone);
      formData.append('guardian_phone', guardian_phone);
      formData.append('aadhaar_no', aadhaar_no);
      formData.append('is_muthallim', is_muthallim);
      formData.append('prev_institution', prev_institution);
      formData.append('prev_place', prev_place);
      formData.append('school_class', school_class);
      formData.append('madrasa_class', madrasa_class);
      formData.append('place', place);
      formData.append('pin', pin);
      formData.append('district', district);
      formData.append('state', state);
      formData.append('address', address);
      formData.append('password', document.getElementById('stPass').value.trim());
      formData.append('batch_id', '');
      formData.append('status', saveMode);

      const photoInput = document.getElementById('stPhoto');
      if (photoInput.files[0]) formData.append('photo', photoInput.files[0]);

      const aadhaarInput = document.getElementById('stAadhaarFile');
      if (aadhaarInput.files[0]) formData.append('aadhaar_doc', aadhaarInput.files[0]);

      try {
        const res = await fetch('/api/admissions', {
          method: 'POST',
          body: formData
        });
        const data = await res.json();
        if (data.success) {
          if (autoPrint) {
            printAdmissionRecord({
              admission_no: data.admission_no,
              roll_no: roll_no,
              full_name: full_name,
              dob: dob,
              father_name: father_name,
              phone: phone,
              guardian_phone: guardian_phone,
              aadhaar_no: aadhaar_no,
              is_muthallim: is_muthallim,
              prev_institution: prev_institution,
              prev_place: prev_place,
              school_class: school_class,
              madrasa_class: madrasa_class,
              place: place,
              pin: pin,
              district: district,
              state: state,
              address: address,
              status: saveMode,
              photo_file: ''
            }, false);
            setTimeout(() => location.reload(), 600);
          } else {
            const msg = saveMode === 'draft'
              ? `Saved as Draft! Admission No: ${data.admission_no}`
              : `Admission submitted! Admission No: ${data.admission_no}`;
            alert(msg);
            location.reload();
          }
        } else {
          alert('Error: ' + (data.error || 'Failed to save admission!'));
        }
      } catch (err) {
        alert('Server connection failed!');
      }
    }

