        '<div class="form-title">' + (isBlank ? 'Student Admission Application Form' : 'Student Admission Record') + '</div>',
        '<div class="top-meta"><div>',
        '<p style="margin:5px 0;font-size:14px;"><strong>Admission No:</strong> ' + (isBlank ? '_______________________' : escapeHtml(info.admission_no)) + '</p>',
        '<p style="margin:5px 0;font-size:14px;"><strong>Roll Number:</strong> ' + (isBlank ? '_______________________' : escapeHtml(info.roll_no)) + '</p>',
        '<p style="margin:5px 0;font-size:13px;color:#475569;"><strong>Date:</strong> ' + today + '</p>',
        '</div><div class="photo-box">',
        (!isBlank && info.photo_file) ? '<img src="' + info.photo_file + '" alt="Student Photo">' : 'Affix Photo',
        '</div></div>',
        '<table class="details">',
        '<tr><td class="lbl">Full Name</td><td colspan="3"><strong>' + escapeHtml(info.full_name, fb) + '</strong></td></tr>',
        '<tr><td class="lbl">Date of Birth</td><td>' + escapeHtml(info.dob, fb) + '</td><td class="lbl">Aadhaar Number</td><td>' + escapeHtml(info.aadhaar_no, fb) + '</td></tr>',
        '<tr><td class="lbl">Father\'s Name</td><td colspan="3">' + escapeHtml(info.father_name, fb) + '</td></tr>',
        '<tr><td class="lbl">Student Phone</td><td>' + escapeHtml(info.phone, fb) + '</td><td class="lbl">Guardian Phone</td><td>' + escapeHtml(info.guardian_phone, fb) + '</td></tr>',
        '<tr><td class="lbl">Studied as Muthallim?</td><td colspan="3">' + muthallimText + '</td></tr>',
        '<tr><td class="lbl">Previous Institution</td><td>' + escapeHtml(info.prev_institution, fb) + '</td><td class="lbl">Institution Place</td><td>' + escapeHtml(info.prev_place, fb) + '</td></tr>',
        '<tr><td class="lbl">Madrasa Class</td><td>' + escapeHtml(info.madrasa_class, fb) + '</td><td class="lbl">School Class</td><td>' + escapeHtml(info.school_class, fb) + '</td></tr>',
        '<tr><td class="lbl">House / Address</td><td colspan="3">' + escapeHtml(info.address, fb) + '</td></tr>',
        '<tr><td class="lbl">Place</td><td>' + escapeHtml(info.place, fb) + '</td><td class="lbl">PIN Code</td><td>' + escapeHtml(info.pin, fb) + '</td></tr>',
        '<tr><td class="lbl">District</td><td>' + escapeHtml(info.district, fb) + '</td><td class="lbl">State</td><td>' + escapeHtml(info.state, fb) + '</td></tr>',
        '</table>',
        '<div class="sig-row"><div class="sig-line">Parent / Guardian Signature</div><div class="sig-line">Authorized Signature</div></div>',
        '</div>',
        footerImg ? '<div class="footer-banner"><img src="' + footerImg + '" alt="Footer"></div>' : '',
        '</div></body></html>'
      ];

      printWin.document.open();
      printWin.document.write(htmlParts.join(''));
      printWin.document.close();

      printWin.onload = () => {
        setTimeout(() => printWin.print(), 250);
      };
    }
  </script>
</body>
</html>