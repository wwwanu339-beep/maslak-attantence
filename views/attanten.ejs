<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mark Attendance</title>
  <link rel="stylesheet" href="/add.css">
  <style>
    .filter-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      margin-bottom: 14px;
    }
    @media (max-width: 680px) {
      .filter-grid { grid-template-columns: 1fr; }
    }
    .field-label {
      display: block;
      font-size: 12px;
      font-weight: 700;
      color: var(--text-muted);
      margin-bottom: 5px;
    }
    input[type="date"] {
      width: 100%;
      padding: 10px 14px;
      border: 1px solid var(--border-color);
      border-radius: 7px;
      font-size: 14px;
      font-family: inherit;
      color: var(--text-main);
      background-color: #f8fafc;
      outline: none;
    }
    .att-toolbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 12px;
      padding-bottom: 10px;
      border-bottom: 1px solid var(--border-color);
    }
    .status-pill-group {
      display: inline-flex;
      gap: 6px;
    }
    .st-btn {
      padding: 6px 12px;
      border-radius: 7px;
      font-size: 12px;
      font-weight: 800;
      border: 1.5px solid #cbd5e1;
      background: #f8fafc;
      color: #475569;
      cursor: pointer;
      transition: 0.15s;
    }
    .st-btn.active-p { background: #dcfce7; border-color: #16a34a; color: #15803d; }
    .st-btn.active-a { background: #fee2e2; border-color: #dc2626; color: #b91c1c; }
    .st-btn.active-l { background: #fef9c3; border-color: #eab308; color: #854d0e; }
  </style>
</head>
<body>
  <div class="container">
    <!-- Top Header -->
    <div class="top-bar">
      <h1 class="top-bar-title">Mark Attendance</h1>
      <a href="/dashboard" class="btn-header-icon" title="Back to Dashboard">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 12H5"></path>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
      </a>
    </div>

    <!-- Filter Selection Card -->
    <div class="portal-card" style="margin-bottom: 16px;">
      <div class="filter-grid">
        <div>
          <label class="field-label">Select Batch</label>
          <select id="attBatchSelect" onchange="onBatchChange()">
            <option value="" disabled selected>-- Choose Batch --</option>
            <% (batches || []).forEach(b => { %>
              <option value="<%= b.id %>"><%= b.name %></option>
            <% }) %>
          </select>
        </div>

        <div>
          <label class="field-label">Select Subject</label>
          <select id="attSubjectSelect" onchange="renderAttendanceList()">
            <option value="" disabled selected>-- Choose Subject --</option>
            <% (subjects || []).forEach(s => { %>
              <option value="<%= s.id %>" data-batch="<%= s.batch_id %>"><%= s.name %></option>
            <% }) %>
          </select>
        </div>

        <div>
          <label class="field-label">Attendance Date</label>
          <input type="date" id="attDateInput" value="<%= today %>">
        </div>
      </div>
    </div>

    <!-- Student Attendance Marking Table -->
    <div class="portal-card">
      <div class="att-toolbar">
        <span class="portal-sel-info">Students (<span id="attStuCount">0</span>)</span>
        <div style="display:flex; gap:8px; flex-wrap:wrap;">
          <button type="button" class="btn btn-sm btn-success" onclick="markAllStatus('present')">All Present (P)</button>
          <button type="button" class="btn btn-sm btn-delete" onclick="markAllStatus('absent')">All Absent (A)</button>
          <button type="button" class="btn btn-sm btn-add" id="btnSaveAtt" onclick="submitAttendance()">Save Attendance</button>
        </div>
      </div>

      <div class="table-responsive">
        <table id="portalPermTable">
          <thead>
            <tr>
              <th style="width:45px;">#</th>
              <th>Adm No</th>
              <th>Student Name</th>
              <th style="text-align:center;">Status (P / A / L)</th>
            </tr>
          </thead>
          <tbody id="attTableBody">
            <tr>
              <td colspan="4" style="text-align:center; padding:24px; color:#64748b;">
                Select a Batch and Subject above to load students.
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <script id="allStudentsJson" type="application/json"><%- JSON.stringify(students || []).replace(/</g, '\\u003c') %></script>

  <script>
    const ALL_STUDENTS = JSON.parse(document.getElementById('allStudentsJson').textContent || '[]');
    const STATUS_MAP = {}; // admission_no -> 'present' | 'absent' | 'leave'

    function onBatchChange() {
      const batchId = document.getElementById('attBatchSelect').value;
      const subSelect = document.getElementById('attSubjectSelect');
      subSelect.value = '';

      subSelect.querySelectorAll('option').forEach(opt => {
        if (!opt.value) return;
        const optBatch = opt.getAttribute('data-batch');
        const show = (optBatch === batchId || optBatch === 'all');
        opt.hidden = !show;
        opt.disabled = !show;
      });

      renderAttendanceList();
    }

    function renderAttendanceList() {
      const batchId = document.getElementById('attBatchSelect').value;
      const tbody = document.getElementById('attTableBody');

      if (!batchId) {
        tbody.innerHTML = '<tr><td colspan="4" style="text-align:center; padding:24px; color:#64748b;">Select a Batch to load students.</td></tr>';
        document.getElementById('attStuCount').innerText = '0';
        return;
      }

      const filtered = ALL_STUDENTS.filter(s => {
        const bList = String(s.batch_id || '').split(',').map(x => x.trim());
        return bList.includes(batchId);
      });

      document.getElementById('attStuCount').innerText = filtered.length;

      if (filtered.length === 0) {
        tbody.innerHTML = '<tr><td colspan="4" style="text-align:center; padding:24px; color:#64748b;">No students found in this batch.</td></tr>';
        return;
      }

      tbody.innerHTML = filtered.map((s, idx) => {
        if (!STATUS_MAP[s.admission_no]) STATUS_MAP[s.admission_no] = 'present';
        const st = STATUS_MAP[s.admission_no];

        return `
          <tr>
            <td><strong>${idx + 1}</strong></td>
            <td><strong>${s.admission_no}</strong></td>
            <td>${s.full_name}</td>
            <td style="text-align:center;">
              <div class="status-pill-group">
                <button type="button" class="st-btn ${st === 'present' ? 'active-p' : ''}" onclick="setStudentStatus('${s.admission_no}', 'present')">P</button>
                <button type="button" class="st-btn ${st === 'absent' ? 'active-a' : ''}" onclick="setStudentStatus('${s.admission_no}', 'absent')">A</button>
                <button type="button" class="st-btn ${st === 'leave' ? 'active-l' : ''}" onclick="setStudentStatus('${s.admission_no}', 'leave')">L</button>
              </div>
            </td>
          </tr>`;
      }).join('');
    }

    function setStudentStatus(admNo, status) {
      STATUS_MAP[admNo] = status;
      renderAttendanceList();
    }

    function markAllStatus(status) {
      const batchId = document.getElementById('attBatchSelect').value;
      if (!batchId) return alert('Please select a Batch first!');

      ALL_STUDENTS.forEach(s => {
        const bList = String(s.batch_id || '').split(',').map(x => x.trim());
        if (bList.includes(batchId)) {
          STATUS_MAP[s.admission_no] = status;
        }
      });
      renderAttendanceList();
    }

    async function submitAttendance() {
      const batch_id = document.getElementById('attBatchSelect').value;
      const subject_id = document.getElementById('attSubjectSelect').value;
      const date = document.getElementById('attDateInput').value;

      if (!batch_id) return alert('Please select a Batch!');
      if (!subject_id) return alert('Please select a Subject!');
      if (!date) return alert('Please select a Date!');

      const filtered = ALL_STUDENTS.filter(s => {
        const bList = String(s.batch_id || '').split(',').map(x => x.trim());
        return bList.includes(batch_id);
      });

      if (filtered.length === 0) return alert('No students to save!');

      const records = filtered.map(s => ({
        student_id: s.admission_no,
        status: STATUS_MAP[s.admission_no] || 'present'
      }));

      const btn = document.getElementById('btnSaveAtt');
      btn.disabled = true;
      btn.innerText = 'Saving...';

      try {
        const res = await fetch('/api/mark-attendance', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ batch_id, subject_id, date, records })
        });
        const data = await res.json();
        if (data.success) {
          alert(data.message || 'Attendance saved successfully!');
        } else {
          alert('Error: ' + (data.error || 'Failed to save attendance!'));
        }
      } catch (err) {
        alert('Server connection error!');
      } finally {
        btn.disabled = false;
        btn.innerText = 'Save Attendance';
      }
    }
  </script>
</body>
</html>
