<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mark Attendance</title>
  <link rel="stylesheet" href="/attanten.css">
</head>
<body>
  <div class="container">
    <!-- Top Header -->
    <div class="top-bar">
      <h1 class="top-bar-title">Mark Attendance</h1>
      <a href="/dashboard" class="btn-header-icon" title="Back to Dashboard">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 12H5"></path>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
      </a>
    </div>

    <!-- 1. Date Picker & Save Bar -->
    <div class="attendance-header">
      <div class="date-box">
        <label for="attDate">Date:</label>
        <input type="date" id="attDate" onchange="loadAttendanceData()">
      </div>
      <button type="button" id="saveAttBtn" class="btn-save" onclick="saveAttendance()">Save Attendance</button>
    </div>

    <!-- 2. Filter Controls -->
    <div class="filter-controls">
      <select id="batchSelect" onchange="onBatchChange()">
        <option value="" disabled selected>Select Batch</option>
        <% if (!user || !user.allowed_batch || user.allowed_batch === 'all') { %>
          <option value="all">All Batches</option>
        <% } %>
        <% (batches || []).forEach(b => { %>
          <option value="<%= b.id %>"><%= b.name %></option>
        <% }) %>
      </select>

      <select id="subjectSelect" onchange="loadAttendanceData()">
        <option value="" disabled selected>Select Subject</option>
        <% (subjects || []).forEach(s => { %>
          <option value="<%= s.id %>" data-batch-id="<%= s.batch_id %>"><%= s.name %></option>
        <% }) %>
      </select>
    </div>

    <!-- 3. Student Cards Container -->
    <div class="attendance-container">
      <div class="top-controls">
        <div>
          <h3>Students (<span id="stuCount">0</span>)</h3>
          <div id="savedByNote" style="font-size: 11.5px; color: #64748b; margin-top: 2px;"></div>
        </div>
        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
          <button type="button" class="btn-action btn-all-absent" onclick="markAll('present')">All Present</button>
          <button type="button" class="btn-action btn-all-present" onclick="markAll('absent')">All Absent</button>
        </div>
      </div>

      <div class="cards-grid" id="cardsGrid">
        <div class="grid-placeholder">Select Batch and Subject to load students.</div>
      </div>
    </div>
  </div>

  <script>
    let CURRENT_STUDENTS = [];
    let STATUS_MAP = {}; // admission_no -> 'present' | 'absent' | 'leave'

    window.addEventListener('DOMContentLoaded', () => {
      const today = new Date().toISOString().split('T')[0];
      document.getElementById('attDate').value = today;

      const batchSel = document.getElementById('batchSelect');
      const realBatches = Array.from(batchSel.options).filter(o => o.value && o.value !== 'all');
      if (realBatches.length === 1) {
        batchSel.value = realBatches[0].value;
        onBatchChange();
      }
    });

    function onBatchChange() {
      const batchId = document.getElementById('batchSelect').value;
      const subSel = document.getElementById('subjectSelect');
      const prevSub = subSel.value;
      let validSubs = [];

      subSel.querySelectorAll('option').forEach(opt => {
        if (!opt.value) return;
        const optBatch = opt.getAttribute('data-batch-id');
        const show = (batchId === 'all' || optBatch === batchId || optBatch === 'all');
        opt.hidden = !show;
        opt.disabled = !show;
        if (show) validSubs.push(opt);
      });

      if (validSubs.length === 1) {
        subSel.value = validSubs[0].value;
      } else if (!validSubs.some(o => o.value === prevSub)) {
        subSel.value = '';
      }

      loadAttendanceData();
    }

    async function loadAttendanceData() {
      const batch_id = document.getElementById('batchSelect').value;
      const subject_id = document.getElementById('subjectSelect').value;
      const date = document.getElementById('attDate').value;
      const grid = document.getElementById('cardsGrid');
      const savedNote = document.getElementById('savedByNote');

      if (!batch_id || !subject_id || !date) {
        grid.innerHTML = '<div class="grid-placeholder">Select Batch and Subject to load students.</div>';
        document.getElementById('stuCount').innerText = '0';
        savedNote.innerText = '';
        return;
      }

      grid.innerHTML = '<div class="grid-placeholder">Loading students...</div>';

      try {
        const res = await fetch(`/api/attendance-data?batch_id=${encodeURIComponent(batch_id)}&subject_id=${encodeURIComponent(subject_id)}&date=${encodeURIComponent(date)}`);
        const data = await res.json();

        if (!data.success) {
          grid.innerHTML = `<div class="grid-placeholder" style="color:#dc2626;">${data.error || 'Error loading data'}</div>`;
          return;
        }

        CURRENT_STUDENTS = data.students || [];
        STATUS_MAP = {};

        CURRENT_STUDENTS.forEach(s => {
          const saved = (data.statusMap && data.statusMap[s.admission_no])
            ? String(data.statusMap[s.admission_no]).trim().toLowerCase()
            : 'present';
          STATUS_MAP[s.admission_no] = saved;
        });

        savedNote.innerText = data.savedBy ? `Last marked by: ${data.savedBy}` : 'Not marked yet for this date';
        renderStudentCards();
      } catch (err) {
        grid.innerHTML = '<div class="grid-placeholder" style="color:#dc2626;">Server connection error!</div>';
      }
    }

    function renderStudentCards() {
      const grid = document.getElementById('cardsGrid');
      const showBatchSub = document.getElementById('batchSelect').value === 'all';
      document.getElementById('stuCount').innerText = CURRENT_STUDENTS.length;

      if (CURRENT_STUDENTS.length === 0) {
        grid.innerHTML = '<div class="grid-placeholder">No active students found in this batch.</div>';
        return;
      }

      grid.innerHTML = CURRENT_STUDENTS.map(s => {
        const st = STATUS_MAP[s.admission_no] || 'present';
        const badgeText = st === 'present' ? 'P' : (st === 'absent' ? 'A' : 'L');
        return `
          <div class="student-card ${st}" onclick="cycleStatus('${s.admission_no}')">
            <span class="status-badge">${badgeText}</span>
            <div class="roll-no">${s.roll_no || s.admission_no}</div>
            <div class="student-name" title="${s.full_name}">${s.full_name}</div>
            ${showBatchSub ? `<div class="student-batch-sub">${s.batch_name}</div>` : ''}
          </div>`;
      }).join('');
    }

    function cycleStatus(admNo) {
      const cur = STATUS_MAP[admNo] || 'present';
      if (cur === 'present') STATUS_MAP[admNo] = 'absent';
      else if (cur === 'absent') STATUS_MAP[admNo] = 'leave';
      else STATUS_MAP[admNo] = 'present';
      renderStudentCards();
    }

    function markAll(status) {
      if (CURRENT_STUDENTS.length === 0) return alert('No students loaded!');
      CURRENT_STUDENTS.forEach(s => {
        STATUS_MAP[s.admission_no] = status;
      });
      renderStudentCards();
    }

    async function saveAttendance() {
      const batch_id = document.getElementById('batchSelect').value;
      const subject_id = document.getElementById('subjectSelect').value;
      const date = document.getElementById('attDate').value;

      if (!batch_id || !subject_id || !date) {
        return alert('Please select Date, Batch, and Subject first!');
      }
      if (CURRENT_STUDENTS.length === 0) {
        return alert('No students to save!');
      }

      const records = CURRENT_STUDENTS.map(s => ({
        admission_no: s.admission_no,
        student_id: s.admission_no,
        batch_id: batch_id === 'all' ? (s.main_batch_id || '') : batch_id,
        status: STATUS_MAP[s.admission_no] || 'present'
      }));

      const btn = document.getElementById('saveAttBtn');
      btn.disabled = true;
      btn.innerText = 'Saving...';

      try {
        const res = await fetch('/api/save-attendance', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ subject_id, date, records })
        });
        const data = await res.json();
        if (data.success) {
          alert(data.message || 'Attendance saved successfully!');
          loadAttendanceData();
        } else {
          alert('Error: ' + (data.error || 'Failed to save attendance!'));
        }
      } catch (err) {
        alert('Server error while saving attendance!');
      } finally {
        btn.disabled = false;
        btn.innerText = 'Save Attendance';
      }
    }
  </script>
</body>
</html>
