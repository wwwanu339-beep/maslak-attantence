<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Online Student Admission Form</title>
  <link rel="stylesheet" href="/student.css">
  <link rel="stylesheet" href="/admission.css">
  <style>
    body {
      background: #f1f5f9;
      padding: 20px 12px;
    }
    .public-form-wrap {
      max-width: 760px;
      margin: 0 auto;
    }
    .brand-top-banner {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      padding: 12px;
      margin-bottom: 16px;
      text-align: center;
    }
    .brand-top-banner img {
      width: 100%;
      max-height: 110px;
      object-fit: contain;
      display: block;
      margin: 0 auto;
    }
    .success-screen {
      display: none;
      text-align: center;
      padding: 36px 20px;
    }
    .success-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 60px;
      height: 60px;
      border-radius: 50%;
      background: #dcfce7;
      color: #16a34a;
      font-size: 28px;
      font-weight: 800;
      margin-bottom: 12px;
    }
  </style>
</head>
<body>

  <%
    const safeBranding = (typeof branding !== 'undefined' && branding) ? branding : { headerUrl: '', footerUrl: '' };
  %>

  <div class="public-form-wrap">
    <!-- Institution Header Banner -->
    <div class="brand-top-banner">
      <% if (safeBranding.headerUrl) { %>
        <img src="<%= safeBranding.headerUrl %>" alt="Institution Header">
      <% } else { %>
        <h2 style="margin: 4px 0; color: #0f172a;">ONLINE STUDENT ADMISSION FORM</h2>
        <p style="margin: 0; font-size: 13px; color: #64748b;">All fields marked with (*) are mandatory</p>
      <% } %>
    </div>

    <!-- Public Admission Form Card (All Fields Mandatory) -->
    <div class="card" id="formCardBox">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; border-bottom: 1px solid #e2e8f0; padding-bottom: 10px;">
        <h3 style="margin: 0;">Student Application Form</h3>
        <% if (user) { %>
          <a href="/admissions" class="btn btn-sm btn-secondary">← Back to Admissions</a>
        <% } %>
      </div>

      <form id="publicAdmissionForm" enctype="multipart/form-data" onsubmit="event.preventDefault(); submitPublicAdmission();">
        <div class="form-grid">
          <div class="field-box full-span">
            <label>Student Full Name: <span class="req-star">*</span></label>
            <input type="text" id="stName" name="full_name" placeholder="Student Full Name" required>
          </div>

          <div class="field-box">
            <label>Date of Birth: <span class="req-star">*</span></label>
            <input type="date" id="stDob" name="dob" required>
          </div>

          <div class="field-box">
            <label>Aadhaar Number: <span class="req-star">*</span></label>
            <input type="text" id="stAadhaar" name="aadhaar_no" placeholder="12-digit Aadhaar Number" maxlength="14" required>
          </div>

          <div class="field-box full-span">
            <label>Father's Name: <span class="req-star">*</span></label>
            <input type="text" id="stFather" name="father_name" placeholder="Father's Name" required>
          </div>

          <div class="field-box">
            <label>Student Phone Number: <span class="req-star">*</span></label>
            <input type="text" id="stPhone" name="phone" placeholder="Student Phone Number" required>
          </div>

          <div class="field-box">
            <label>Parent / Guardian Phone Number: <span class="req-star">*</span></label>
            <input type="text" id="stGuardianPhone" name="guardian_phone" placeholder="Parent / Guardian Phone" required>
          </div>

          <div class="field-box">
            <label>PIN Code (Auto-fills District & State): <span class="req-star">*</span> <span id="pubPinStatus" style="font-size:11px; color:#2563eb;"></span></label>
            <input type="text" id="stPin" name="pin" placeholder="6-digit PIN Code" maxlength="6" oninput="lookupPinCode(this.value)" required>
          </div>

          <div class="field-box">
            <label>Place: <span class="req-star">*</span></label>
            <input type="text" id="stPlace" name="place" placeholder="Place / Locality" required>
          </div>

          <div class="field-box">
            <label>District: <span class="req-star">*</span></label>
            <input type="text" id="stDistrict" name="district" placeholder="District" required>
          </div>

          <div class="field-box">
            <label>State: <span class="req-star">*</span></label>
            <input type="text" id="stState" name="state" placeholder="State" required>
          </div>

          <div class="field-box full-span">
            <label>House Name / Full Address: <span class="req-star">*</span></label>
            <textarea id="stAddress" name="address" rows="2" placeholder="House Name, Post Office, Street" required></textarea>
          </div>

          <!-- Muthallim Previous Study Toggle -->
          <div class="field-box">
            <label>Studied as Muthallim Previously? <span class="req-star">*</span></label>
            <select id="stIsMuthallim" name="is_muthallim" onchange="toggleMuthallimFields()" required>
              <option value="no" selected>No (Fresh)</option>
              <option value="yes">Yes (Studied Previously)</option>
            </select>
          </div>

          <div class="field-box">
            <label>Create Student Portal Password: <span class="req-star">*</span></label>
            <input type="password" id="stPass" name="password" placeholder="Enter a login password" required>
          </div>

          <div id="pubMuthallimBox" class="form-grid full-span" style="display: none; background: #f8fafc; padding: 12px; border-radius: 8px; border: 1px dashed #94a3b8;">
            <div class="field-box">
              <label>Previous Institution Name: <span class="req-star">*</span></label>
              <input type="text" id="stPrevInst" name="prev_institution" placeholder="Name of Previous Madrasa / Dars / College">
            </div>
            <div class="field-box">
              <label>Institution Place: <span class="req-star">*</span></label>
              <input type="text" id="stPrevPlace" name="prev_place" placeholder="Location / Place of Institution">
            </div>
          </div>

          <div class="field-box">
            <label>Current Madrasa Class: <span class="req-star">*</span></label>
            <input type="text" id="stMadrasaClass" name="madrasa_class" placeholder="e.g., Class 5 / Hifz" required>
          </div>

          <div class="field-box">
            <label>Current School Class: <span class="req-star">*</span></label>
            <input type="text" id="stSchoolClass" name="school_class" placeholder="e.g., 5th Standard / Plus One" required>
          </div>

          <div class="field-box">
            <label>Student Photo Upload: <span class="req-star">*</span></label>
            <input type="file" id="stPhoto" name="photo" accept="image/*" required>
          </div>

          <div class="field-box">
            <label>Aadhaar Document Upload (Image/PDF): <span class="req-star">*</span></label>
            <input type="file" id="stAadhaarFile" name="aadhaar_doc" accept="image/*,.pdf" required>
          </div>
        </div>

        <div style="margin-top: 20px; display: flex; justify-content: flex-end; gap: 10px;">
          <button type="submit" id="pubSubmitBtn" class="btn btn-primary" style="padding: 11px 24px; font-size: 14px;">
            Submit Application
          </button>
        </div>
      </form>
    </div>

    <!-- Success Screen -->
    <div class="card success-screen" id="successCardBox">
      <div class="success-badge">✓</div>
      <h2 style="margin: 0 0 8px; color: #0f172a;">Application Submitted Successfully!</h2>
      <p style="color: #475569; font-size: 14px; margin: 0 0 18px;">
        Your application has been received. Admission Number will be allotted after office verification.
      </p>

      <div style="display: flex; justify-content: center; gap: 10px; flex-wrap: wrap;">
        <button type="button" class="btn btn-primary" onclick="location.reload()">Submit Another Application</button>
        <% if (user) { %>
          <a href="/admissions" class="btn btn-secondary">Go to Admission List</a>
        <% } %>
      </div>
    </div>

    <% if (safeBranding.footerUrl) { %>
      <div class="brand-top-banner" style="margin-top: 16px;">
        <img src="<%= safeBranding.footerUrl %>" alt="Institution Footer">
      </div>
    <% } %>
  </div>

  <script>
    function toggleMuthallimFields() {
      const val = document.getElementById('stIsMuthallim').value;
      const isYes = val === 'yes';
      document.getElementById('pubMuthallimBox').style.display = isYes ? 'grid' : 'none';
      document.getElementById('stPrevInst').required = isYes;
      document.getElementById('stPrevPlace').required = isYes;
    }

    async function lookupPinCode(pinVal) {
      const cleanPin = String(pinVal || '').replace(/\D/g, '');
      const statusEl = document.getElementById('pubPinStatus');
      if (cleanPin.length !== 6) {
        statusEl.innerText = '';
        return;
      }

      statusEl.innerText = 'Fetching...';
      try {
        const res = await fetch(`https://api.postalpincode.in/pincode/${cleanPin}`);
        const data = await res.json();
        if (Array.isArray(data) && data[0]?.Status === 'Success' && data[0]?.PostOffice?.length > 0) {
          const po = data[0].PostOffice[0];
          const placeEl = document.getElementById('stPlace');
          if (!placeEl.value.trim()) placeEl.value = po.Name || '';
          document.getElementById('stDistrict').value = po.District || '';
          document.getElementById('stState').value = po.State || '';
          statusEl.innerText = '✓ Found';
        } else {
          statusEl.innerText = 'Invalid PIN';
        }
      } catch (err) {
        statusEl.innerText = '';
      }
    }

    async function submitPublicAdmission() {
      const form = document.getElementById('publicAdmissionForm');
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const btn = document.getElementById('pubSubmitBtn');
      btn.disabled = true;
      btn.innerText = 'Submitting...';

      const formData = new FormData(form);

      try {
        const res = await fetch('/api/public-admissions', {
          method: 'POST',
          body: formData
        });
        const data = await res.json();
        if (data.success) {
          document.getElementById('formCardBox').style.display = 'none';
          document.getElementById('successCardBox').style.display = 'block';
          window.scrollTo({ top: 0, behavior: 'smooth' });
        } else {
          alert('Error: ' + (data.error || 'Failed to submit application!'));
        }
      } catch (err) {
        alert('Server connection failed. Please try again!');
      } finally {
        btn.disabled = false;
        btn.innerText = 'Submit Application';
      }
    }
  </script>
</body>
</html>