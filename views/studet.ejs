<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Active Students</title>
  <link rel="stylesheet" href="/student.css">
  <!-- jsPDF & AutoTable CDN for Direct PDF Download -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
  
</head>
<body>

  <div class="container">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 10px;">
      <h1 style="margin: 0;">Active Student List (<%= students.length %>)</h1>
      <div style="display: flex; gap: 10px;">
        <a href="/admissions" class="btn btn-primary">+ New Admission</a>
        <a href="/dashboard" class="btn btn-secondary">Dashboard</a>
      </div>
    </div>

    <!-- Search & Download Toolbar -->
    <div class="card" style="padding: 16px; margin-bottom: 16px;">
      <div class="toolbar">
        <input type="text" id="studentSearch" class="search-input" autocomplete="off" placeholder="Search by Name, Admission No, Roll No, Phone, or Batch..." onkeyup="filterStudentTable()">
        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
          <button type="button" class="btn btn-success" onclick="openExportModal('csv')">
            Download CSV
          </button>
          <button type="button" class="btn btn-danger" onclick="openExportModal('pdf')">
            Download PDF
          </button>
        </div>
      </div>
    </div>

    <!-- Active Students Table -->
    <div id="studentlist" class="card">
      <div class="table-responsive">
        <table id="studentsTable">
          <thead>
            <tr>
              <th class="chk-col"><input type="checkbox" id="selectAllStudents" onclick="toggleSelectAll(this)" title="Select All"></th>
              <th>Adm No</th>
              <th style="width: 80px;">Roll No</th>
              <th>Student Name</th>
              <th>DOB</th>
              <th>Phone Number</th>
              <th>Batch</th>
              <th style="text-align: center;">Action</th>
            </tr>
          </thead>
          <tbody>
            <% if (students.length === 0) { %>
              <tr>
                <td colspan="8" style="text-align: center; color: #64748b; padding: 20px;">
                  No active students found. Please activate students from the Admission Portal.
                </td>
              </tr>
            <% } %>

            <% students.forEach(s => { %>
              <tr class="student-row"
                  data-adm="<%= s.admission_no %>"
                  data-roll="<%= s.roll_no || '' %>"
                  data-name="<%= s.full_name %>"
                  data-dob="<%= s.dob || '' %>"
                  data-father="<%= s.father_name || '' %>"
                  data-phone="<%= s.phone || '' %>"
                  data-batch="<%= s.batch_name || '' %>">
                <td class="chk-col">
                  <input type="checkbox" class="student-select-chk" value="<%= s.admission_no %>">
                </td>
                <td><strong><%= s.admission_no %></strong></td>
                <td><span class="badge-roll"><%= s.roll_no || '-' %></span></td>
                <td><strong><%= s.full_name %></strong></td>
                <td><%= s.dob || '-' %></td>
                <td><%= s.phone || '-' %></td>
                <td><span class="badge"><%= s.batch_name || 'No Batch' %></span></td>
                <td>
                  <div class="action-btns">
                    <button type="button" class="btn btn-sm btn-warning"
                      data-adm="<%= s.admission_no %>"
                      data-name="<%= s.full_name %>"
                      onclick="openPassModal(this)">
                      Set Pass
                    </button>
                    <button type="button" class="btn btn-sm btn-edit-std" 
                      data-adm="<%= s.admission_no %>"
                      data-roll="<%= s.roll_no || '' %>"
                      data-name="<%= s.full_name %>"
                      data-dob="<%= s.dob || '' %>"
                      data-phone="<%= s.phone || '' %>"
                      data-batch="<%= s.batch_id || '' %>"
                      onclick="openEditModal(this)">
                      Update
                    </button>
                    <button type="button" class="btn btn-sm btn-danger" onclick="deleteStudent('<%= s.admission_no %>')">
                      Delete
                    </button>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Column Selection Modal for Export (CSV / PDF) -->
  <div id="exportColModal" class="modal" onclick="if(event.target === this) closeExportModal()">
    <div class="modal-content" style="max-width: 420px;">
      <div class="modal-header">
        <h3 id="exportModalTitle">Select Columns to Download</h3>
        <button type="button" class="modal-close" onclick="closeExportModal()">×</button>
      </div>
      <p id="exportSelectedCount" style="font-size: 13px; color: #64748b; margin-bottom: 6px;"></p>
      <input type="hidden" id="exportFormatType">

      <div class="col-select-grid">
        <label class="col-chk-item">
          <input type="checkbox" name="exportCols" value="adm" data-label="Adm No" checked>
          <span>Admission No</span>
        </label>
        <label class="col-chk-item">
          <input type="checkbox" name="exportCols" value="roll" data-label="Roll No" checked>
          <span>Roll No</span>
        </label>
        <label class="col-chk-item">
          <input type="checkbox" name="exportCols" value="name" data-label="Full Name" checked>
          <span>Student Name</span>
        </label>
        <label class="col-chk-item">
          <input type="checkbox" name="exportCols" value="father" data-label="Father Name" checked>
          <span>Father's Name</span>
        </label>
        <label class="col-chk-item">
          <input type="checkbox" name="exportCols" value="dob" data-label="DOB" checked>
          <span>Date of Birth</span>
        </label>
        <label class="col-chk-item">
          <input type="checkbox" name="exportCols" value="phone" data-label="Phone" checked>
          <span>Phone Number</span>
        </label>
        <label class="col-chk-item" style="grid-column: 1 / -1;">
          <input type="checkbox" name="exportCols" value="batch" data-label="Batch" checked>
          <span>Batch</span>
        </label>
      </div>

      <div class="modal-actions">
        <button type="button" class="btn btn-secondary" onclick="closeExportModal()">Cancel</button>
        <button type="button" id="confirmExportBtn" class="btn btn-primary" onclick="executeExport()">Download</button>
      </div>
    </div>
  </div>

  <!-- Update Student Modal -->
  <div id="editModal" class="modal" onclick="if(event.target === this) closeEditModal()">
    <div class="modal-content">
      <div class="modal-header">
        <h3>Update Student</h3>
        <button type="button" class="modal-close" onclick="closeEditModal()">×</button>
      </div>
      
      <div class="modal-form-body">
        <label class="field-label">Permanent Admission No (Read-only):</label>
        <input type="text" id="editAdm" readonly style="background: #e2e8f0; font-weight: bold; cursor: not-allowed;">

        <label class="field-label">Roll Number:</label>
        <input type="number" id="editRoll" placeholder="Roll Number">
        
        <label class="field-label">Full Name:</label>
        <input type="text" id="editName" placeholder="Student Name" required>

        <label class="field-label">Date of Birth:</label>
        <input type="date" id="editDob">

        <label class="field-label">Phone Number:</label>
        <input type="text" id="editPhone" placeholder="Phone Number">

        <label class="field-label">New Password (Leave blank to keep current password):</label>
        <input type="password" id="editPass" placeholder="Enter new password (optional)">
        
        <div class="batch-selection-wrapper">
          <span class="batch-selection-title">Select Batches:</span>
          <div class="batch-checkbox-group">
            <% batches.forEach(b => { %>
              <label class="batch-chip">
                <input type="checkbox" name="editStudentBatches" value="<%= b.id %>">
                <span><%= b.name %></span>
              </label>
            <% }) %>
          </div>
        </div>
      </div>

      <div class="modal-actions">
        <button type="button" class="btn btn-secondary" onclick="closeEditModal()">Cancel</button>
        <button type="button" class="btn btn-primary" onclick="saveStudentUpdate()">Save Changes</button>
      </div>
    </div>
  </div>

  <!-- Set Password Modal -->
  <div id="passModal" class="modal" onclick="if(event.target === this) closePassModal()">
    <div class="modal-content" style="max-width: 380px;">
      <div class="modal-header">
        <h3>Set Student Password</h3>
        <button type="button" class="modal-close" onclick="closePassModal()">×</button>
      </div>
      <p id="passStudentName" style="font-size: 13px; color: #64748b; margin-bottom: 12px;"></p>
      <input type="hidden" id="passStudentAdm">
      
      <div class="modal-form-body">
        <label class="field-label">New Password:</label>
        <input type="password" id="newStudentPass" placeholder="Enter new password" required>
      </div>

      <div class="modal-actions">
        <button type="button" class="btn btn-secondary" onclick="closePassModal()">Cancel</button>
        <button type="button" class="btn btn-primary" onclick="saveStudentPassword()">Save Password</button>
      </div>
    </div>
  </div>

  <script>
    window.addEventListener('DOMContentLoaded', () => {
      const searchInput = document.getElementById('studentSearch');
      if (searchInput && document.activeElement === searchInput) {
        searchInput.blur();
      }
    });

    function filterStudentTable() {
      const query = document.getElementById('studentSearch').value.toLowerCase().trim();
      const rows = document.querySelectorAll('#studentsTable tbody tr.student-row');
      rows.forEach(row => {
        const text = row.innerText.toLowerCase();
        row.style.display = text.includes(query) ? '' : 'none';
      });
    }

    function toggleSelectAll(masterChk) {
      const rows = document.querySelectorAll('#studentsTable tbody tr.student-row');
      rows.forEach(row => {
        if (row.style.display !== 'none') {
          const chk = row.querySelector('.student-select-chk');
          if (chk) chk.checked = masterChk.checked;
        }
      });
    }

    // Open Column Selection Modal
    function openExportModal(format) {
      const checkedBoxes = document.querySelectorAll('.student-select-chk:checked');
      if (checkedBoxes.length === 0) {
        return alert('Please select at least one student checkbox first!');
      }

      document.getElementById('exportFormatType').value = format;
      document.getElementById('exportModalTitle').innerText = format === 'pdf'
        ? 'Select Columns for PDF'
        : 'Select Columns for CSV';
      document.getElementById('exportSelectedCount').innerText = `Selected Students: ${checkedBoxes.length}`;

      const confirmBtn = document.getElementById('confirmExportBtn');
      confirmBtn.innerText = format === 'pdf' ? 'Download PDF' : 'Download CSV';
      confirmBtn.className = format === 'pdf' ? 'btn btn-danger' : 'btn btn-success';

      document.getElementById('exportColModal').style.display = 'flex';
    }

    function closeExportModal() {
      document.getElementById('exportColModal').style.display = 'none';
    }

    function executeExport() {
      const format = document.getElementById('exportFormatType').value;
      const selectedColInputs = Array.from(document.querySelectorAll('input[name="exportCols"]:checked'));

      if (selectedColInputs.length === 0) {
        return alert('Please select at least one column to download!');
      }

      const selectedCols = selectedColInputs.map(cb => ({
        key: cb.value,
        label: cb.getAttribute('data-label')
      }));

      const checkedRows = Array.from(document.querySelectorAll('.student-select-chk:checked'))
        .map(chk => chk.closest('tr'));

      const today = new Date().toISOString().split('T')[0];

      if (format === 'csv') {
        const headers = selectedCols.map(c => c.label);
        const csvRows = [headers.join(',')];

        checkedRows.forEach(row => {
          const values = selectedCols.map(c => {
            const rawVal = row.dataset[c.key] || '';
            return `"${String(rawVal).replace(/"/g, '""')}"`;
          });
          csvRows.push(values.join(','));
        });

        const blob = new Blob([csvRows.join('\n')], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = url;
        link.download = `Students_List_${today}.csv`;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        URL.revokeObjectURL(url);
        closeExportModal();
      } else if (format === 'pdf') {
        if (!window.jspdf) {
          return alert('PDF library is loading. Please check your internet connection and try again.');
        }

        const { jsPDF } = window.jspdf;
        const doc = new jsPDF('p', 'mm', 'a4');

        doc.setFontSize(15);
        doc.setTextColor(15, 23, 42);
        doc.text('Active Student List', 14, 16);

        doc.setFontSize(9.5);
        doc.setTextColor(100, 116, 139);
        doc.text(`Generated Date: ${today}   |   Total Students: ${checkedRows.length}`, 14, 22);

        const headRow = ['#', ...selectedCols.map(c => c.label)];
        const bodyRows = checkedRows.map((row, idx) => [
          idx + 1,
          ...selectedCols.map(c => row.dataset[c.key] || '-')
        ]);

        doc.autoTable({
          startY: 27,
          head: [headRow],
          body: bodyRows,
          theme: 'grid',
          styles: {
            fontSize: 9,
            cellPadding: 3,
            textColor: [30, 41, 59],
            lineColor: [203, 213, 225],
            lineWidth: 0.2
          },
          headStyles: {
            fillColor: [37, 99, 235],
            textColor: 255,
            fontStyle: 'bold',
            halign: 'center'
          },
          columnStyles: {
            0: { halign: 'center', cellWidth: 10 }
          },
          alternateRowStyles: {
            fillColor: [248, 250, 252]
          }
        });

        doc.save(`Students_List_${today}.pdf`);
        closeExportModal();
      }
    }

    function openEditModal(btn) {
      document.getElementById('editAdm').value = btn.dataset.adm;
      document.getElementById('editRoll').value = btn.dataset.roll;
      document.getElementById('editName').value = btn.dataset.name;
      document.getElementById('editDob').value = btn.dataset.dob;
      document.getElementById('editPhone').value = btn.dataset.phone;
      document.getElementById('editPass').value = '';

      const assignedBatches = String(btn.dataset.batch || '').split(',').map(b => b.trim());
      document.querySelectorAll('input[name="editStudentBatches"]').forEach(cb => {
        cb.checked = assignedBatches.includes(cb.value);
      });

      document.getElementById('editModal').style.display = 'flex';
    }

    function closeEditModal() {
      document.getElementById('editModal').style.display = 'none';
    }

    async function saveStudentUpdate() {
      const admNo = document.getElementById('editAdm').value;
      const roll_no = document.getElementById('editRoll').value.trim();
      const full_name = document.getElementById('editName').value.trim();
      const dob = document.getElementById('editDob').value;
      const phone = document.getElementById('editPhone').value.trim();
      const password = document.getElementById('editPass').value.trim();

      const batch_id = Array.from(document.querySelectorAll('input[name="editStudentBatches"]:checked'))
        .map(cb => cb.value)
        .join(',');

      if (!full_name || !batch_id) {
        return alert('Full Name and at least one Batch are required!');
      }

      try {
        const res = await fetch(`/api/students/${encodeURIComponent(admNo)}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ full_name, dob, phone, batch_id, roll_no, password })
        });
        const data = await res.json();
        if (data.success) location.reload();
        else alert('Error: ' + data.error);
      } catch (err) {
        alert('Failed to update student details!');
      }
    }

    function openPassModal(btn) {
      document.getElementById('passStudentAdm').value = btn.dataset.adm;
      document.getElementById('passStudentName').innerText = `Student: ${btn.dataset.name} (${btn.dataset.adm})`;
      document.getElementById('newStudentPass').value = '';
      document.getElementById('passModal').style.display = 'flex';
    }

    function closePassModal() {
      document.getElementById('passModal').style.display = 'none';
    }

    async function saveStudentPassword() {
      const admNo = document.getElementById('passStudentAdm').value;
      const password = document.getElementById('newStudentPass').value.trim();
      if (!password) return alert('Please enter a new password!');

      try {
        const res = await fetch(`/api/students/${encodeURIComponent(admNo)}/password`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ password })
        });
        const data = await res.json();
        if (data.success) {
          alert('Password updated successfully!');
          closePassModal();
        } else {
          alert('Error: ' + data.error);
        }
      } catch (err) {
        alert('Failed to save password!');
      }
    }

    async function deleteStudent(admNo) {
      if (!confirm('Are you sure you want to remove this student from the active list?')) return;
      try {
        const res = await fetch(`/api/students/${encodeURIComponent(admNo)}`, { method: 'DELETE' });
        const data = await res.json();
        if (data.success) location.reload();
        else alert('Error: ' + data.error);
      } catch (err) {
        alert('Failed to remove student!');
      }
    }
  </script>
</body>
</html>