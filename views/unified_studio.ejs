    function switchLeftTab(tabName, btnEl) {
      document.querySelectorAll('.dock-tab').forEach(b => b.classList.remove('active'));
      if (btnEl) btnEl.classList.add('active');
      document.getElementById('dockTab_elements').style.display = tabName === 'elements' ? 'block' : 'none';
      document.getElementById('dockTab_layers').style.display = tabName === 'layers' ? 'block' : 'none';
      document.getElementById('dockTab_students').style.display = tabName === 'students' ? 'block' : 'none';
    }

    function changeZoom(delta) {
      zoomLevel = Math.max(0.5, Math.min(1.6, +(zoomLevel + delta).toFixed(1)));
      document.getElementById('zoomWrapper').style.transform = `scale(${zoomLevel})`;
      document.getElementById('zoomLabel').innerText = Math.round(zoomLevel * 100) + '%';
    }

    function switchStudioMode(mode) {
      CURRENT_MODE = mode;
      document.getElementById('tabFormStudio').classList.toggle('active', mode === 'form');
      document.getElementById('tabIdStudio').classList.toggle('active', mode === 'id');
      document.getElementById('btnAddPage').style.display = mode === 'form' ? 'inline-flex' : 'none';
      document.getElementById('idCardSizeBox').style.display = mode === 'id' ? 'block' : 'none';
      document.getElementById('tabBtnStudents').style.display = mode === 'id' ? 'block' : 'none';

      if (mode === 'form') {
        zoomLevel = 0.8;
        switchLeftTab('elements', document.querySelector('.dock-tab'));
      } else {
        zoomLevel = 1.1;
        document.getElementById('idCanvasW').value = idState.canvasW;
        document.getElementById('idCanvasH').value = idState.canvasH;
      }
      document.getElementById('zoomWrapper').style.transform = `scale(${zoomLevel})`;
      document.getElementById('zoomLabel').innerText = Math.round(zoomLevel * 100) + '%';

      activePage = 1;
      selectedIds = [];
      undoStack = [];
      redoStack = [];
      commitHistory();
      renderPalette();
      renderAllPages();
      updateInspector();
    }

    function populateStudentPicker() {
      const box = document.getElementById('studioStuList');
      const params = new URLSearchParams(window.location.search);
      const preAdms = (params.get('adms') || '').split(',').map(a => a.trim()).filter(Boolean);

      box.innerHTML = ALL_STUDENTS.map((s, idx) => {
        const isChecked = IS_STUDENT_MODE ? (idx === 0) : (preAdms.length > 0 ? preAdms.includes(s.admission_no) : idx === 0);
        return `
          <label class="layer-item stu-pick-row" data-search="${(s.full_name + ' ' + s.admission_no).toLowerCase()}">
            <span style="display:flex; align-items:center; gap:6px;">
              <input type="checkbox" class="studio-stu-chk" value="${idx}" ${isChecked ? 'checked' : ''} onchange="renderAllPages()">
              <span><strong>${s.full_name}</strong><br><small style="color:var(--text-muted)">${s.admission_no}</small></span>
            </span>
          </label>`;
      }).join('');
    }

    function filterStudioStudents() {
      const q = document.getElementById('stuSearchBox').value.toLowerCase().trim();
      document.querySelectorAll('.stu-pick-row').forEach(row => {
        row.style.display = row.dataset.search.includes(q) ? 'flex' : 'none';
      });
    }

    function getCheckedStudents() {
      const checked = Array.from(document.querySelectorAll('.studio-stu-chk:checked')).map(c => ALL_STUDENTS[Number(c.value)]).filter(Boolean);
      return checked.length > 0 ? checked : [SAMPLE_ST];
    }

    function setIdCardDimensions(w, h) {
      commitHistory();
      idState.canvasW = w;
      idState.canvasH = h;
      document.getElementById('idCanvasW').value = w;
      document.getElementById('idCanvasH').value = h;
      renderAllPages();
    }

    function updateIdCanvasSize() {
      commitHistory();
      idState.canvasW = parseInt(document.getElementById('idCanvasW').value) || 240;
      idState.canvasH = parseInt(document.getElementById('idCanvasH').value) || 380;
      renderAllPages();
    }

    function commitHistory() {
      const st = getState();
      const snap = JSON.stringify(st);
      if (undoStack.length === 0 || undoStack[undoStack.length - 1] !== snap) {
        undoStack.push(snap);
        if (undoStack.length > 50) undoStack.shift();
        redoStack = [];
      }
      document.getElementById('btnUndo').disabled = undoStack.length <= 1;
      document.getElementById('btnRedo').disabled = redoStack.length === 0;
    }

    function undoAction() {
      if (undoStack.length <= 1) return;
      redoStack.push(undoStack.pop());
      const prev = JSON.parse(undoStack[undoStack.length - 1]);
      if (CURRENT_MODE === 'id') idState = prev; else formState = prev;
      renderPalette(); renderAllPages(); updateInspector();
      document.getElementById('btnUndo').disabled = undoStack.length <= 1;
      document.getElementById('btnRedo').disabled = redoStack.length === 0;
    }

    function redoAction() {
      if (redoStack.length === 0) return;
      const next = redoStack.pop();
      undoStack.push(next);
      const state = JSON.parse(next);
      if (CURRENT_MODE === 'id') idState = state; else formState = state;
      renderPalette(); renderAllPages(); updateInspector();
      document.getElementById('btnUndo').disabled = undoStack.length <= 1;
      document.getElementById('btnRedo').disabled = redoStack.length === 0;
    }

    // Drag & Drop Layers Reordering
    function renderPalette() {
      const st = getState();
      const list = document.getElementById('fieldToggleList');
      // Reverse index so top layer is at the top of list
      const revList = st.items.map((item, origIdx) => ({ item, origIdx })).reverse();

      list.innerHTML = revList.map(({ item, origIdx }) => {
        const isSel = selectedIds.includes(item.id);
        return `
          <div class="layer-item ${isSel ? 'selected' : ''}"
               draggable="true"
               ondragstart="onLayerDragStart(event, ${origIdx})"
               ondragover="onLayerDragOver(event)"
               ondragleave="onLayerDragLeave(event)"
               ondrop="onLayerDrop(event, ${origIdx})"
               onclick="handleSelect('${item.id}', event.shiftKey)">
            <span style="display:flex; align-items:center; overflow:hidden;">
              <span class="layer-drag-grip">☰</span>
              <span style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">${item.label}</span>
            </span>
            <input type="checkbox" ${item.visible ? 'checked' : ''} onclick="event.stopPropagation()" onchange="toggleVis('${item.id}', this.checked)">
          </div>`;
      }).join('');
    }

    function onLayerDragStart(e, origIdx) {
      draggedLayerIdx = origIdx;
      e.dataTransfer.effectAllowed = 'move';
    }
    function onLayerDragOver(e) {
      e.preventDefault();
      e.currentTarget.classList.add('drag-over-top');
    }
    function onLayerDragLeave(e) {
      e.currentTarget.classList.remove('drag-over-top');
    }
    function onLayerDrop(e, targetOrigIdx) {
      e.preventDefault();
      e.currentTarget.classList.remove('drag-over-top');
      if (draggedLayerIdx === null || draggedLayerIdx === targetOrigIdx) return;

      const st = getState();
      commitHistory();
      const [movedItem] = st.items.splice(draggedLayerIdx, 1);
      st.items.splice(targetOrigIdx, 0, movedItem);
      draggedLayerIdx = null;
      renderPalette();
      renderAllPages();
    }

    function toggleVis(id, vis) {
      const it = getState().items.find(x => x.id === id);
      if (it) { commitHistory(); it.visible = vis; renderAllPages(); }
    }

    function addNewPage() {
      if (CURRENT_MODE !== 'form') return;
      commitHistory();
      formState.totalPages++;
      activePage = formState.totalPages;
      renderAllPages();
    }

    function deletePage(pgNum) {
      if (formState.totalPages <= 1) return;
      commitHistory();
      formState.items = formState.items.filter(it => (it.page || 1) !== pgNum);
      formState.items.forEach(it => { if ((it.page || 1) > pgNum) it.page--; });
      formState.totalPages--;
      activePage = Math.min(activePage, formState.totalPages);
      renderPalette(); renderAllPages();
    }

    function alignSelectedBoxes(mode) {
      const st = getState();
      const sel = st.items.filter(it => selectedIds.includes(it.id) && it.visible);
      if (sel.length < 2) return;
      commitHistory();

      if (mode === 'left') { const m = Math.min(...sel.map(i => i.x)); sel.forEach(i => i.x = m); }
      else if (mode === 'right') { const m = Math.max(...sel.map(i => i.x + i.width)); sel.forEach(i => i.x = Math.max(0, m - i.width)); }
      else if (mode === 'centerX') { const avg = sel.reduce((s, i) => s + (i.x + i.width / 2), 0) / sel.length; sel.forEach(i => i.x = Math.round(Math.max(0, avg - i.width / 2))); }
      else if (mode === 'top') { const m = Math.min(...sel.map(i => i.y)); sel.forEach(i => i.y = m); }
      else if (mode === 'middleY') { const avg = sel.reduce((s, i) => s + (i.y + (i.height || 25) / 2), 0) / sel.length; sel.forEach(i => i.y = Math.round(Math.max(0, avg - (i.height || 25) / 2))); }
      renderAllPages();
    }

    function addCustomShape(shapeType) {
      const st = getState();
      commitHistory();
      const uid = 'custom_' + Date.now();
      let item = { id: uid, page: activePage, isCustom: true, x: 40, y: 120, visible: true };

      if (shapeType === 'rect') item = { ...item, label: 'Box', type: 'rect', width: 150, height: 60, border: true, borderWidth: 2, borderRadius: 6, bgColor: 'transparent', textColor: '#0f172a', borderColor: '#334155', fontSize: 12, align: 'left' };
      else if (shapeType === 'circle') item = { ...item, label: 'Circle', type: 'circle', width: 80, height: 80, border: true, borderWidth: 2, borderRadius: 100, bgColor: 'transparent', textColor: '#0f172a', borderColor: '#1e3a8a', fontSize: 12, align: 'center' };
      else if (shapeType === 'line') item = { ...item, label: 'Line', type: 'line', width: Math.min(200, st.canvasW - 40), height: 2, border: false, borderWidth: 2, borderRadius: 0, bgColor: '#334155', textColor: '#0f172a', borderColor: '#334155', fontSize: 12, align: 'left' };
      else item = { ...item, label: 'Heading / Text', type: 'text', customText: 'Heading Text', width: 160, height: 26, border: false, borderWidth: 1, borderRadius: 0, bgColor: 'transparent', textColor: '#0f172a', borderColor: '#cbd5e1', fontSize: 12, bold: true, align: 'left' };

      st.items.push(item);
      selectedIds = [uid];
      renderPalette(); renderAllPages(); updateInspector();
    }

    function deleteSelectedCustom() {
      const st = getState();
      if (!st.items.some(it => selectedIds.includes(it.id) && it.isCustom)) return;
      commitHistory();
      st.items = st.items.filter(it => !(selectedIds.includes(it.id) && it.isCustom));
      selectedIds = [];
      renderPalette(); renderAllPages(); updateInspector();
    }

    function selectAllBoxes() {
      const st = getState();
      selectedIds = st.items.filter(it => it.visible && (it.page || 1) === activePage).map(it => it.id);
      renderPalette(); renderAllPages(); updateInspector();
    }

    function clearSelection() {
      selectedIds = [];
      renderPalette(); renderAllPages(); updateInspector();
    }

    function renderAllPages() {
      const st = getState();
      const container = document.getElementById('multiPageContainer');
      const previewStudent = getCheckedStudents()[0] || SAMPLE_ST;
      const hdrUrl = CURRENT_MODE === 'id' ? ID_HEADER : FORM_HEADER;
      const ftrUrl = CURRENT_MODE === 'id' ? ID_FOOTER : FORM_FOOTER;

      let html = '';
      for (let p = 1; p <= st.totalPages; p++) {
        const pageItems = st.items.filter(it => it.visible && (it.page || 1) === p);
        const innerHtml = pageItems.map((it, idx) => buildBoxHtml(it, idx + 1, previewStudent, hdrUrl, ftrUrl)).join('');

        html += `
          <div>
            <div class="page-chip-bar" style="width:${st.canvasW}px;">
              <span>${CURRENT_MODE === 'id' ? 'ID Card Canvas' : `Page ${p} of ${st.totalPages}`}</span>
              ${(CURRENT_MODE === 'form' && st.totalPages > 1) ? `<button type="button" class="ctx-mini-btn" style="color:#dc2626;" onclick="deletePage(${p})">Remove Page</button>` : ''}
            </div>
            <div class="design-sheet ${activePage === p ? 'active-sheet' : ''}"
                 style="width:${st.canvasW}px; height:${st.canvasH}px;"
                 onmousedown="if(event.target === this) { activePage = ${p}; clearSelection(); }">
              ${innerHtml}
            </div>
          </div>`;
      }
      container.innerHTML = html;

      if (typeof JsBarcode !== 'undefined') {
        container.querySelectorAll('.studio-barcode-svg').forEach(svg => {
          const code = svg.getAttribute('data-code') || 'ADM-001';
          try { JsBarcode(svg, code, { format: 'CODE128', width: 1.3, height: 24, displayValue: true, fontSize: 9, margin: 0, background: 'transparent' }); } catch (e) {}
        });
      }
    }

    function buildBoxHtml(it, zIdx, studentData, hdrUrl, ftrUrl) {
      const isSel = !IS_STUDENT_MODE && selectedIds.includes(it.id);
      const bCol = it.borderColor || '#cbd5e1';
      const bWidth = it.borderWidth || 1;
      const bgCol = it.bgColor || 'transparent';
      const txtCol = it.textColor || '#0f172a';
      const borderCss = it.border ? `${bWidth}px solid ${bCol}` : 'none';
      const rad = it.type === 'circle' ? '50%' : `${it.borderRadius || 0}px`;
      const weight = it.bold ? '700' : '500';
      let content = '';

      if (it.type === 'header') {
        content = hdrUrl
          ? `<img src="${hdrUrl}" crossorigin="anonymous" class="banner-fit" style="border-radius:${rad};">`
          : `<div style="font-weight:800; font-size:${it.fontSize}px; text-align:${it.align}; color:${txtCol}; padding:6px;">${it.customText}</div>`;
      } else if (it.type === 'footer') {
        content = ftrUrl
          ? `<img src="${ftrUrl}" crossorigin="anonymous" class="banner-fit" style="border-radius:${rad};">`
          : `<div style="font-weight:600; font-size:${it.fontSize}px; text-align:${it.align}; color:${txtCol}; padding:4px;">${it.customText}</div>`;
      } else if (it.type === 'photo') {
        content = `<div class="photo-placeholder" style="border-radius:${rad};">
          ${studentData.photo_file ? `<img src="${studentData.photo_file}" crossorigin="anonymous">` : 'Photo'}
        </div>`;
      } else if (it.type === 'barcode') {
        content = `<div style="text-align:${it.align};"><svg class="studio-barcode-svg" data-code="${studentData.admission_no || 'ADM-001'}"></svg></div>`;
      } else if (it.type === 'sig') {
        content = `<div style="border-top:${bWidth}px solid ${bCol}; padding-top:4px; font-weight:${weight}; font-size:${it.fontSize}px; text-align:${it.align}; color:${txtCol};">${it.customText}</div>`;
      } else if (it.type === 'text') {
        content = `<div style="font-weight:${weight}; font-size:${it.fontSize}px; text-align:${it.align}; color:${txtCol};">${it.customText}</div>`;
      } else if (it.type === 'rect' || it.type === 'circle') {
        content = '';
      } else if (it.type === 'line') {
        content = `<div style="width:100%; height:100%; background:${bCol};"></div>`;
      } else {
        // Pure Data Field Box (Separate from Heading)
        const val = studentData[it.fieldKey] || '-';
        content = `<div style="font-size:${it.fontSize}px; text-align:${it.align}; font-weight:${weight}; color:${txtCol}; line-height:1.25;">${val}</div>`;
      }

      const padCss = ['line', 'rect', 'circle', 'photo', 'header', 'footer'].includes(it.type) ? 'padding:0;' : 'padding:3px 5px;';

      // 8-Direction Resize Handles when single box selected
      const handlesHtml = (isSel && selectedIds.length === 1) ? `
        <div class="resize-handle rh-nw" onmousedown="startResize(event, '${it.id}', 'nw')"></div>
        <div class="resize-handle rh-n"  onmousedown="startResize(event, '${it.id}', 'n')"></div>
        <div class="resize-handle rh-ne" onmousedown="startResize(event, '${it.id}', 'ne')"></div>
        <div class="resize-handle rh-e"  onmousedown="startResize(event, '${it.id}', 'e')"></div>
        <div class="resize-handle rh-se" onmousedown="startResize(event, '${it.id}', 'se')"></div>
        <div class="resize-handle rh-s"  onmousedown="startResize(event, '${it.id}', 's')"></div>
        <div class="resize-handle rh-sw" onmousedown="startResize(event, '${it.id}', 'sw')"></div>
        <div class="resize-handle rh-w"  onmousedown="startResize(event, '${it.id}', 'w')"></div>
      ` : '';

      return `
        <div class="drag-el ${isSel ? 'selected' : ''}"
             id="box_${it.id}"
             onmousedown="startDrag(event, '${it.id}')"
             style="left:${it.x}px; top:${it.y}px; width:${it.width}px; height:${it.height}px; z-index:${zIdx}; background:${bgCol}; border:${borderCss}; border-radius:${rad}; ${padCss}">
          ${content}
          ${handlesHtml}
        </div>`;
    }

    function handleSelect(id, isShift) {
      if (isShift) selectedIds = selectedIds.includes(id) ? selectedIds.filter(x => x !== id) : [...selectedIds, id];
      else selectedIds = [id];
      renderPalette(); renderAllPages(); updateInspector();
    }

    function updateInspector() {
      const st = getState();
      const count = selectedIds.length;
      const toolsEl = document.getElementById('activeItemTools');
      const badgeEl = document.getElementById('selBoxName');

      if (count === 0) {
        badgeEl.innerText = 'Click any item to select & drag edges to resize';
        toolsEl.style.display = 'none';
        return;
      }

      toolsEl.style.display = 'flex';
      document.getElementById('ctxMultiAlign').style.display = count > 1 ? 'flex' : 'none';

      if (count > 1) {
        badgeEl.innerText = `${count} Items Selected`;
        document.getElementById('ctxTextEditGroup').style.display = 'none';
        document.getElementById('ctxDeleteGroup').style.display = st.items.some(it => selectedIds.includes(it.id) && it.isCustom) ? 'flex' : 'none';
        return;
      }

      const it = st.items.find(x => x.id === selectedIds[0]);
      if (!it) return;

      badgeEl.innerText = it.label;
      document.getElementById('inspFontSize').value = it.fontSize || 12;
      document.getElementById('inspBold').checked = Boolean(it.bold);
      document.getElementById('inspWidth').value = Math.round(it.width || 150);
      document.getElementById('inspHeight').value = Math.round(it.height || 24);
      document.getElementById('inspRadius').value = it.type === 'circle' ? 100 : (it.borderRadius || 0);
      document.getElementById('inspAlign').value = it.align || 'left';
      document.getElementById('inspShowBorder').checked = Boolean(it.border);
      document.getElementById('inspBorderWidth').value = it.borderWidth || 1;
      document.getElementById('inspBorderColor').value = it.borderColor || '#cbd5e1';
      document.getElementById('inspTextColor').value = it.textColor || '#0f172a';
      document.getElementById('inspBgColor').value = (it.bgColor && it.bgColor !== 'transparent') ? it.bgColor : '#ffffff';

      const hasTxt = ['header', 'footer', 'text', 'sig'].includes(it.type);
      document.getElementById('ctxTextEditGroup').style.display = hasTxt ? 'flex' : 'none';
      document.getElementById('ctxDeleteGroup').style.display = it.isCustom ? 'flex' : 'none';
      if (hasTxt) document.getElementById('inspCustomText').value = it.customText || '';
    }

    function updateSelectedProp(prop, val) {
      const st = getState();
      selectedIds.forEach(id => {
        const it = st.items.find(x => x.id === id);
        if (it) it[prop] = val;
      });
      renderAllPages();
    }

    // Move & Resize Mouse Handlers
    function startDrag(e, id) {
      if (IS_STUDENT_MODE) return;
      e.stopPropagation();
      if (e.shiftKey) selectedIds = selectedIds.includes(id) ? selectedIds.filter(x => x !== id) : [...selectedIds, id];
      else if (!selectedIds.includes(id)) selectedIds = [id];
      renderPalette(); renderAllPages(); updateInspector();

      interactionMode = 'move';
      hasChanged = false;
      startMouseX = e.clientX;
      startMouseY = e.clientY;
    }

    function startResize(e, id, dir) {
      if (IS_STUDENT_MODE) return;
      e.stopPropagation();
      const it = getState().items.find(x => x.id === id);
      if (!it) return;

      interactionMode = 'resize';
      resizeDir = dir;
      activeResizeId = id;
      hasChanged = false;
      startMouseX = e.clientX;
      startMouseY = e.clientY;
      initBoxRect = { x: it.x, y: it.y, width: it.width, height: it.height };
    }

    window.addEventListener('mousemove', (e) => {
      if (!interactionMode) return;
      const st = getState();
      const dx = (e.clientX - startMouseX) / zoomLevel;
      const dy = (e.clientY - startMouseY) / zoomLevel;

      if (interactionMode === 'move' && selectedIds.length > 0) {
        if (Math.abs(dx) < 0.5 && Math.abs(dy) < 0.5) return;
        hasChanged = true;
        startMouseX = e.clientX;
        startMouseY = e.clientY;

        selectedIds.forEach(id => {
          const it = st.items.find(x => x.id === id);
          if (it) {
            it.x = Math.round(Math.max(0, Math.min(st.canvasW - it.width, it.x + dx)));
            it.y = Math.round(Math.max(0, Math.min(st.canvasH - 5, it.y + dy)));
            const el = document.getElementById(`box_${it.id}`);
            if (el) { el.style.left = it.x + 'px'; el.style.top = it.y + 'px'; }
          }
        });
      } else if (interactionMode === 'resize' && activeResizeId) {
        const it = st.items.find(x => x.id === activeResizeId);
        if (!it) return;
        hasChanged = true;

        let { x, y, width, height } = initBoxRect;
        if (resizeDir.includes('e')) width = Math.max(10, Math.min(st.canvasW - x, width + dx));
        if (resizeDir.includes('s')) height = Math.max(2, Math.min(st.canvasH - y, height + dy));
        if (resizeDir.includes('w')) {
          const newW = Math.max(10, width - dx);
          x = Math.max(0, x + (width - newW));
          width = newW;
        }
        if (resizeDir.includes('n')) {
          const newH = Math.max(2, height - dy);
          y = Math.max(0, y + (height - newH));
          height = newH;
        }

        it.x = Math.round(x);
        it.y = Math.round(y);
        it.width = Math.round(width);
        it.height = Math.round(height);

        const el = document.getElementById(`box_${it.id}`);
        if (el) {
          el.style.left = it.x + 'px';
          el.style.top = it.y + 'px';
          el.style.width = it.width + 'px';
          el.style.height = it.height + 'px';
        }
        document.getElementById('inspWidth').value = it.width;
        document.getElementById('inspHeight').value = it.height;
      }
    });

    window.addEventListener('mouseup', () => {
      if (interactionMode && hasChanged) commitHistory();
      interactionMode = null;
      activeResizeId = null;
    });

    window.addEventListener('keydown', (e) => {
      if (IS_STUDENT_MODE || ['INPUT', 'SELECT', 'TEXTAREA'].includes(document.activeElement.tagName)) return;
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'z') { e.preventDefault(); e.shiftKey ? redoAction() : undoAction(); return; }
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'y') { e.preventDefault(); redoAction(); return; }
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'a') { e.preventDefault(); selectAllBoxes(); return; }
      if (e.key === 'Delete' || e.key === 'Backspace') { deleteSelectedCustom(); return; }

      if (['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown'].includes(e.key) && selectedIds.length > 0) {
        e.preventDefault();
        const st = getState();
        const step = e.shiftKey ? 8 : 2;
        selectedIds.forEach(id => {
          const it = st.items.find(x => x.id === id);
          if (!it) return;
          if (e.key === 'ArrowLeft') it.x = Math.max(0, it.x - step);
          if (e.key === 'ArrowRight') it.x = Math.min(st.canvasW - it.width, it.x + step);
          if (e.key === 'ArrowUp') it.y = Math.max(0, it.y - step);
          if (e.key === 'ArrowDown') it.y = Math.min(st.canvasH - 5, it.y + step);
        });
        renderAllPages(); commitHistory();
      }
    });

    async function uploadActiveBanner(type) {
      const inp = type === 'header' ? document.getElementById('upHeaderFile') : document.getElementById('upFooterFile');
      if (!inp.files[0]) return;
      const fd = new FormData();
      const apiUrl = CURRENT_MODE === 'id' ? '/api/id-card-branding' : '/api/admission-branding';
      const fieldName = CURRENT_MODE === 'id' ? (type === 'header' ? 'id_card_header' : 'id_card_footer') : (type === 'header' ? 'print_header' : 'print_footer');
      fd.append(fieldName, inp.files[0]);

      const res = await fetch(apiUrl, { method: 'POST', body: fd });
      const data = await res.json();
      if (data.success) {
        if (CURRENT_MODE === 'id') {
          if (data.headerUrl) ID_HEADER = data.headerUrl + '?t=' + Date.now();
          if (data.footerUrl) ID_FOOTER = data.footerUrl + '?t=' + Date.now();
        } else {
          if (data.headerUrl) FORM_HEADER = data.headerUrl + '?t=' + Date.now();
          if (data.footerUrl) FORM_FOOTER = data.footerUrl + '?t=' + Date.now();
        }
        renderAllPages();
      }
    }

    async function saveCurrentLayout() {
      const st = getState();
      const endpoint = CURRENT_MODE === 'id' ? '/api/id-card-template' : '/api/admission-form-template';
      const res = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(st)
      });
      const data = await res.json();
      if (data.success) alert('Saved successfully for all devices & students!');
      else alert('Error: ' + data.error);
    }

    function resetCurrentLayout() {
      commitHistory();
      if (CURRENT_MODE === 'id') {
        idState = { items: JSON.parse(JSON.stringify(DEFAULT_ID_ITEMS)), totalPages: 1, canvasW: 240, canvasH: 380 };
      } else {
        formState = { items: JSON.parse(JSON.stringify(DEFAULT_FORM_ITEMS)), totalPages: 1, canvasW: 794, canvasH: 1123 };
      }
      selectedIds = [];
      renderPalette(); renderAllPages(); updateInspector(); commitHistory();
    }

    function downloadStudentIdImage() {
      const card = document.querySelector('.design-sheet');
      if (!card) return;
      const st = getCheckedStudents()[0] || SAMPLE_ST;
      html2canvas(card, { scale: 3, useCORS: true, backgroundColor: '#ffffff' }).then(canvas => {
        const link = document.createElement('a');
        link.download = `${st.admission_no}_ID_Card.png`;
        link.href = canvas.toDataURL('image/png');
        link.click();
      });
    }

    function printOutput() {
      const st = getState();
      const studentsToPrint = CURRENT_MODE === 'id' ? getCheckedStudents() : [SAMPLE_ST];
      const hdrUrl = CURRENT_MODE === 'id' ? ID_HEADER : FORM_HEADER;
      const ftrUrl = CURRENT_MODE === 'id' ? ID_FOOTER : FORM_FOOTER;

      let sheetsHtml = '';
      studentsToPrint.forEach(stu => {
        for (let p = 1; p <= st.totalPages; p++) {
          const pageItems = st.items.filter(it => it.visible && (it.page || 1) === p);
          const inner = pageItems.map((it, idx) => buildBoxHtml(it, idx + 1, stu, hdrUrl, ftrUrl)).join('');
          sheetsHtml += `<div class="print-sheet" style="width:${st.canvasW}px; height:${st.canvasH}px;">${inner}</div>`;
        }
      });

      const win = window.open('', '_blank', 'width=850,height=950');
      win.document.open();
      win.document.write(`
        <!DOCTYPE html><html><head><title>Print</title>
        <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js"><\/script>
        <style>
          * { box-sizing: border-box; -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
          body { margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
          .print-sheet { position: relative; overflow: hidden; page-break-after: always; break-after: page; }
          .print-sheet:last-child { page-break-after: auto; break-after: auto; }
          .drag-el { position: absolute; }
          .resize-handle { display: none !important; }
          .photo-placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; overflow: hidden; }
          .photo-placeholder img { width: 100%; height: 100%; object-fit: cover; }
          .banner-fit { width: 100%; height: 100%; object-fit: contain; display: block; }
        </style></head><body>${sheetsHtml}
        <script>
          document.querySelectorAll('.studio-barcode-svg').forEach(svg => {
            JsBarcode(svg, svg.getAttribute('data-code') || 'ADM-001', { format: 'CODE128', width: 1.3, height: 24, displayValue: true, fontSize: 9, margin: 0, background: 'transparent' });
          });
          setTimeout(() => window.print(), 300);
        <\/script></body></html>
      `);
      win.document.close();
    }
  </script>
</body>
</html>